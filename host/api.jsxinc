/**
 * TIME RULER - host/api.jsxinc
 *
 * TR.API - the ONLY namespace the CEP panel calls. Every method is callable as
 *
 *     TIME_RULER.API.<name>(jsonStringOrEmpty)
 *
 * - accepts 0 or 1 argument;
 * - the argument, when present, is a JSON STRING (never an object from the panel);
 * - every method returns a JSON STRING envelope (never a JS object):
 *
 *     { "ok": boolean, "code": string, "message": string,
 *       "data": object|null, "warnings": array }
 *
 * Only AE-touching methods reach the After Effects DOM; all access is guarded
 * so the module also loads cleanly under Node.js for smoke testing (ES3 subset).
 */

var TR = $.global.TIME_RULER;
if (typeof TR === "undefined") { TR = {}; $.global.TIME_RULER = TR; }

/**
 * Fallback JSON bridge for bare evaluation contexts (Node smoke harness) where
 * bootstrap.jsx has not installed TR.JSON yet. Under ExtendScript this stays a
 * no-op because bootstrap always installs TR.JSON first.
 * Kept in sync with the installJsonBridge() helper in bootstrap.jsx.
 */
if (typeof TR.JSON !== "object" || TR.JSON === null) {
    TR.JSON = (function () {
        function jsonEngine() {
            if (typeof JSON !== "undefined" && JSON !== null &&
                typeof JSON.parse === "function" && typeof JSON.stringify === "function") {
                return JSON;
            }
            return null;
        }
        return {
            parse: function (s) {
                TR.lastJsonError = null;
                try {
                    var g = jsonEngine();
                    if (g === null) { throw new Error("No JSON engine available."); }
                    return g.parse(s);
                } catch (e) {
                    TR.lastJsonError = String(e && e.message ? e.message : e);
                    if (TR.log) { TR.log("ERROR", "TR.JSON.parse failed: " + TR.lastJsonError); }
                    return null;
                }
            },
            stringify: function (o) {
                TR.lastJsonError = null;
                try {
                    var g = jsonEngine();
                    if (g === null) { throw new Error("No JSON engine available."); }
                    var s = g.stringify(o);
                    return (typeof s === "string") ? s : "";
                } catch (e) {
                    TR.lastJsonError = String(e && e.message ? e.message : e);
                    if (TR.log) { TR.log("ERROR", "TR.JSON.stringify failed: " + TR.lastJsonError); }
                    return "";
                }
            }
        };
    })();
}

TR.API = (function () {

    /* ------------------------------------------------------------------ */
    /* Envelope helpers                                                    */
    /* ------------------------------------------------------------------ */

    function err(code, message) {
        return { code: code, message: message };
    }

    function failEnvelope(e) {
        if (e !== null && typeof e === "object" && typeof e.code === "string") {
            return {
                ok: false,
                code: e.code,
                message: (typeof e.message === "string" && e.message.length > 0) ? e.message : String(e.code),
                data: (typeof e.data === "undefined") ? null : e.data,
                warnings: (e.warnings && typeof e.warnings.length === "number") ? e.warnings : []
            };
        }
        var msg = String(e && e.message ? e.message : e);
        var line = (e && typeof e.line !== "undefined" && e.line !== null) ? e.line : null;
        return {
            ok: false,
            code: "HOST_EXCEPTION",
            message: msg + (line !== null ? " @line " + line : ""),
            data: null,
            warnings: []
        };
    }

    function toJson(envelope) {
        var s = TR.JSON.stringify(envelope);
        if (typeof s === "string" && s.length > 0) { return s; }
        /* Always return a parseable JSON string, even if serialization failed. */
        return "{\"ok\":false,\"code\":\"HOST_SERIALIZE_ERROR\",\"message\":\"Could not serialize envelope to JSON.\",\"data\":null,\"warnings\":[]}";
    }

    /**
     * parsePayload: ''/undefined -> {}; object -> as-is (defensive); string ->
     * guarded TR.JSON.parse. Throws {code:"BAD_PAYLOAD"|-style} objects that the
     * run() wrapper turns into honest error envelopes.
     */
    function parsePayload(s) {
        if (s === undefined || s === null || s === "") { return {}; }
        if (typeof s === "object") { return s; } /* defensive: tolerate pre-parsed object */
        if (typeof s !== "string") {
            throw err("BAD_PAYLOAD", "Payload must be a JSON string (or empty).");
        }
        var CFG = (TR && TR.core && TR.core.config) ? TR.core.config : null;
        if (CFG && CFG.LIMITS && s.length > CFG.LIMITS.MAX_PAYLOAD_CHARS) {
            throw err("PAYLOAD_TOO_LARGE",
                "Payload is " + s.length + " chars; limit is MAX_PAYLOAD_CHARS (" + CFG.LIMITS.MAX_PAYLOAD_CHARS + ").");
        }
        var v = TR.JSON.parse(s);
        if (v === null || typeof v !== "object") {
            throw err("BAD_PAYLOAD",
                "Payload is not a JSON object: " + (TR.lastJsonError || "parse returned no object"));
        }
        return v;
    }

    /**
     * safeRun: executes fn(rawArg) inside try/catch and serializes the result.
     * fn either returns a data object (-> ok envelope) or throws a {code,...}
     * object (-> error envelope) / a native Error (-> HOST_EXCEPTION).
     */
    function safeRun(fn, rawArg, okMessage, okWarnings) {
        try {
            var data = fn(rawArg);
            return toJson({
                ok: true,
                code: "OK",
                message: okMessage,
                data: (typeof data === "undefined") ? null : data,
                warnings: (okWarnings && okWarnings.length) ? okWarnings : []
            });
        } catch (e) {
            return toJson(failEnvelope(e));
        }
    }

    /* validateConfig keeps its envelope.warnings in sync with data.warnings. */
    function safeRunWithWarnings(fn, rawArg, okMessage) {
        try {
            var result = fn(rawArg);
            return toJson({
                ok: true,
                code: "OK",
                message: okMessage,
                data: result.data,
                warnings: (result.warnings && result.warnings.length) ? result.warnings : []
            });
        } catch (e) {
            return toJson(failEnvelope(e));
        }
    }

    /* ------------------------------------------------------------------ */
    /* Module lookups (lazy + guarded: never crash on partial host load)   */
    /* ------------------------------------------------------------------ */

    function configModule() {
        if (TR.core && TR.core.config) { return TR.core.config; }
        throw err("HOST_NOT_READY", "TR.core.config is not loaded; check bootstrap loadErrors.");
    }

    function validationModule() {
        if (TR.core && TR.core.validation) { return TR.core.validation; }
        throw err("HOST_NOT_READY", "TR.core.validation is not loaded; check bootstrap loadErrors.");
    }

    function geometryModule() {
        if (TR.core && TR.core.geometry) { return TR.core.geometry; }
        throw err("HOST_NOT_READY", "TR.core.geometry is not loaded; check bootstrap loadErrors.");
    }

    /**
     * AE adapter modules (Milestone 3). Loaded by bootstrap BEFORE api.jsxinc,
     * but lookups stay lazy so a bare eval under a smoke harness stays honest.
     */
    function ae() {
        if (TR.ae && TR.ae.composition && TR.ae.metadata && TR.ae.shapeBuilder &&
            TR.ae.textBuilder && TR.ae.controllerBuilder && TR.ae.layerManager) {
            return TR.ae;
        }
        throw err("HOST_NOT_READY", "TR.ae.* adapter modules are not loaded; check bootstrap loadErrors.");
    }

    function errData(code, message, data) {
        var e = err(code, message);
        e.data = data;
        return e;
    }

    /* ------------------------------------------------------------------ */
    /* AE access (guarded, only here - never in core modules)              */
    /* ------------------------------------------------------------------ */

    function assertAE() {
        if (typeof app === "undefined" || app === null) {
            throw err("HOST_UNAVAILABLE", "After Effects host is not available (no `app` global).");
        }
    }

    function safeOs() {
        try {
            if (typeof $ !== "undefined" && $ !== null && typeof $.os === "string") { return $.os; }
        } catch (eOs) { /* ignore */ }
        return "unknown";
    }

    /* ------------------------------------------------------------------ */
    /* Method implementations                                              */
    /* ------------------------------------------------------------------ */

    function implPing() {
        return {
            pong: true,
            ready: TR.ready === true,
            loadErrors: (TR.loadErrors && TR.loadErrors.length) ? TR.loadErrors : []
        };
    }

    function implVersion() {
        return {
            product: TR.product || "TIME_RULER",
            version: TR.version || "0.0.0",
            schemaVersion: TR.schemaVersion || "1.0",
            api: "1.0"
        };
    }

    function implGetHostInfo() {
        assertAE();
        var aeVersion = "unavailable";
        try { aeVersion = String(app.version); } catch (eV) { /* guarded */ }
        return {
            aeVersion: aeVersion,
            hostName: "AEFT",
            os: safeOs(),
            engine: "ExtendScript",
            debug: TR.debug === true
        };
    }

    /**
     * Delegates to TR.ae.composition (the single guarded entry point for the
     * active comp; identical NO_PROJECT / NO_ACTIVE_COMP contract).
     */
    function implGetActiveCompInfo() {
        var comp = ae().composition.getActiveComp();
        return ae().composition.compInfoOf(comp);
    }

    function implValidateConfig(rawArg) {
        var cfg = parsePayload(rawArg);
        var normalized = configModule().normalize(cfg);
        var result = validationModule().validate(normalized);
        /* ok stays TRUE even when the config is invalid: the validation call
         * itself succeeded. The verdict travels in data.valid. */
        return {
            data: {
                valid: result.valid,
                errors: result.errors,
                warnings: result.warnings
            },
            warnings: result.warnings
        };
    }

    function implGetPresetDefaults() {
        return { defaults: configModule().defaults() };
    }

    /* ------------------------------------------------------------------ */
    /* Undo-group helper (REAL implementation, used by Milestone 3+)        */
    /* ------------------------------------------------------------------ */

    /**
     * TR.API._withUndo(name, fn): wraps AE-mutating work in one undo step.
     * Only for AE-mutating calls (generate/update/regenerate/detach);
     * read-only calls must NOT use it. try/finally guarantees the group closes.
     */
    function withUndo(name, fn) {
        var undoName = String(name || "TIME RULER");
        var began = false;
        try {
            if (typeof app !== "undefined" && app !== null && typeof app.beginUndoGroup === "function") {
                app.beginUndoGroup(undoName);
                began = true;
            }
            return fn();
        } finally {
            if (began) {
                try { app.endUndoGroup(); } catch (eEnd) {
                    if (TR.log) { TR.log("ERROR", "app.endUndoGroup failed: " + String(eEnd && eEnd.message ? eEnd.message : eEnd)); }
                }
            }
        }
    }

    /* ------------------------------------------------------------------ */
    /* Public API surface                                                  */
    /* ------------------------------------------------------------------ */

    /**
     * Each method is a function so safeRun executes per CALL (0 or 1 arg),
     * never at module load. All methods return a JSON string envelope.
     */
    var api = {
        ping: function (rawArg) {
            return safeRun(implPing, rawArg, "TIME RULER host is alive.");
        },
        version: function (rawArg) {
            return safeRun(implVersion, rawArg, "Host version information.");
        },
        getHostInfo: function (rawArg) {
            return safeRun(implGetHostInfo, rawArg, "Host information.");
        },
        getActiveCompInfo: function (rawArg) {
            return safeRun(implGetActiveCompInfo, rawArg, "Active composition information.");
        },
        getPresetDefaults: function (rawArg) {
            return safeRun(implGetPresetDefaults, rawArg, "Default configuration.");
        },
        validateConfig: function (rawArg) {
            return safeRunWithWarnings(implValidateConfig, rawArg, "Configuration validated.");
        }
    };

    /* ------------------------------------------------------------------ */
    /* Milestone 3 — Native AE Generator (generate + listInstances)        */
    /* ------------------------------------------------------------------ */
    /* update / regenerate / detach remain honest stubs (Milestone 6).      */

    function notImplemented() {
        throw err("NOT_IMPLEMENTED", "Implemented in Milestone 6 of the build.");
    }

    /* ------------------------------ naming helpers ------------------- */

    function pad4(n) {
        var s = String(n);
        while (s.length < 4) { s = "0" + s; }
        return s;
    }

    /* Label hard cap on the GENERATION side (validation caps at 400 per
     * LIMITS; this 500 cap is the adapter's own safety valve, spec §8). */
    var LABELS_HARD_CAP = 500;
    /* Progress preview sampling budget (spec: ≤ 240 points). */
    var PROGRESS_MAX_POINTS = 240;
    /* Arc baseline sampling: at most 3 degrees per straight segment. */
    var ARC_STEP_DEG = 3;

    /* ------------------------------ label selection ------------------ */

    /**
     * Applies labelEvery + collisionMode filtering over plan.labels.
     *   labelEvery: keep labels whose plan index satisfies index % n === 0.
     *   collisionMode:
     *     "allow_overlap" | "every_nth" -> keep the filtered list as-is
     *     "alternate"                   -> keep every 2nd of the filtered list
     *     "hide"                        -> walk the filtered list and drop any
     *                                      label whose PATH DISTANCE to the
     *                                      previous KEPT label is smaller than
     *                                      the estimated min gap
     *                                      fontSize * 0.6 * text.length
     *                                      (heuristic: average glyph advance
     *                                      ≈ 0.6 em — documented in the M3
     *                                      report; real text metrics arrive
     *                                      with the in-AE pass).
     */
    function selectLabels(plan, typo) {
        var all = plan.labels;
        var labelEvery = 1;
        if (typo && typeof typo.labelEvery === "number" && isFinite(typo.labelEvery) && typo.labelEvery >= 1) {
            labelEvery = Math.floor(typo.labelEvery);
        }
        var filtered = [];
        for (var i = 0; i < all.length; i++) {
            if (all[i].index % labelEvery === 0) { filtered[filtered.length] = all[i]; }
        }

        var mode = typo ? typo.collisionMode : "alternate";
        var kept = filtered;

        if (mode === "alternate") {
            kept = [];
            for (var a = 0; a < filtered.length; a += 2) { kept[kept.length] = filtered[a]; }
        } else if (mode === "hide") {
            kept = [];
            var prev = null;
            var fontSize = (typo && typeof typo.fontSize === "number" && typo.fontSize > 0) ? typo.fontSize : 30;
            for (var h = 0; h < filtered.length; h++) {
                var cand = filtered[h];
                var keep = true;
                if (prev !== null) {
                    var dist = pathDistance(plan, prev, cand);
                    var minGap = fontSize * 0.6 * String(cand.text).length;
                    if (dist < minGap) { keep = false; }
                }
                if (keep) { kept[kept.length] = cand; prev = cand; }
            }
        }
        /* "allow_overlap" / "every_nth": keep as filtered */
        return kept;
    }

    /**
     * Distance along the ruler path between two labels (for the "hide"
     * collision heuristic). Circular/arc: arc length = radius * |dAngle| (raw
     * angles are sequential, no wrap-around needed). Linear: euclidean.
     */
    function pathDistance(plan, a, b) {
        if (plan.type === "linear") {
            var dx = a.x - b.x, dy = a.y - b.y;
            return Math.sqrt(dx * dx + dy * dy);
        }
        var dAng = Math.abs(a.angleDeg - b.angleDeg) * Math.PI / 180;
        return plan.radius * dAng;
    }

    /* ------------------------------ label rotation ------------------- */

    /**
     * Rotation semantics (circular/arc only; linear stays horizontal in v1):
     *   horizontal    -> 0
     *   radial        -> angleDeg
     *   tangential    -> angleDeg + 90
     *   auto_upright  -> radial rule, +180 when normalized angle in (90,270)
     */
    function labelRotation(plan, lbl, typo) {
        if (plan.type === "linear") { return 0; }
        var angle = (typeof lbl.angleDeg === "number") ? lbl.angleDeg : 0;
        var mode = typo ? typo.orientation : "radial";
        var rot = 0;
        if (mode === "horizontal") {
            rot = 0;
        } else if (mode === "tangential") {
            rot = angle + 90;
        } else if (mode === "auto_upright") {
            rot = angle;
            var norm = angle - 360 * Math.floor(angle / 360);
            if (norm > 90 && norm < 270) { rot = angle + 180; }
        } else {
            rot = angle; /* "radial" */
        }
        return rot;
    }

    /* ------------------------------ geometry helpers ----------------- */

    /** Layer origin: comp center for circular/arc, baseline midpoint for linear. */
    function layerOrigin(plan) {
        if (plan.type === "linear") {
            var b = plan.baseline;
            return [(b.x1 + b.x2) / 2, (b.y1 + b.y2) / 2];
        }
        return [plan.cx, plan.cy];
    }

    /**
     * geometry.jsxinc resolveCenter() reads center as {x, y}, while the config
     * schema (and resolveAuto) stores it as an array [x, y]. The core modules
     * are frozen, so the adapter converts the PLAN INPUT here without mutating
     * the resolved config (the controller CFG snapshot must keep the schema
     * shape). Returns a 2-level shallow clone: cfg with geometry.center as
     * {x, y}. A non-numeric or missing center returns cfg as-is so the core
     * applies its own fallback (comp center) or throws its own coded error.
     */
    function centerAsPoint(cfg) {
        if (cfg === null || typeof cfg !== "object") { return cfg; }
        var geo = cfg.geometry;
        if (geo === null || typeof geo !== "object") { return cfg; }
        var c = geo.center;
        if (c === null || typeof c !== "object") { return cfg; }
        var x = null, y = null;
        if (typeof c.length === "number") { /* array [x, y] */
            if (typeof c[0] === "number" && isFinite(c[0])) { x = c[0]; }
            if (typeof c[1] === "number" && isFinite(c[1])) { y = c[1]; }
        } else { /* already {x, y} */
            if (typeof c.x === "number" && isFinite(c.x)) { x = c.x; }
            if (typeof c.y === "number" && isFinite(c.y)) { y = c.y; }
        }
        if (x === null || y === null) { return cfg; }
        var geoCopy = {}, out = {}, k;
        for (k in geo) { if (geo.hasOwnProperty(k)) { geoCopy[k] = geo[k]; } }
        geoCopy.center = { x: x, y: y };
        for (k in cfg) { if (cfg.hasOwnProperty(k)) { out[k] = cfg[k]; } }
        out.geometry = geoCopy;
        return out;
    }

    /**
     * Full-circle intent: a circular ruler whose CONFIGURED sweep is >= 360.
     * geometry.jsxinc subtracts the seam gap from a bounded full circle, so
     * plan.baseline.kind becomes "arc" (effective sweep 354) even though the
     * drawn outline is a closed ring. Cyclic full sweeps and seamGap 0 already
     * yield baseline.kind "circle". Used for the baseline outline decision
     * only (closed Ellipse); ticks/labels/teeth keep the seam-gap layout.
     */
    function fullCircleIntent(cfg) {
        var geo = (cfg && cfg.geometry) ? cfg.geometry : null;
        var sweep = (geo && typeof geo.sweepAngle === "number" && isFinite(geo.sweepAngle))
            ? geo.sweepAngle : 360;
        return sweep >= 360 - 0.001;
    }

    /**
     * Samples the circular/arc baseline as a straight-segment polyline with at
     * most ARC_STEP_DEG degrees per segment, open (segments:false).
     */
    function sampleBaselineArc(plan, origin) {
        var dirSign = (plan.direction === "counter_clockwise") ? -1 : 1;
        var steps = Math.max(2, Math.ceil(Math.abs(plan.sweep) / ARC_STEP_DEG));
        var pts = [];
        var geo = geometryModule();
        for (var i = 0; i <= steps; i++) {
            var t = i / steps;
            var angle = plan.startAngle + dirSign * plan.sweep * t;
            var p = geo.pointOnCircle(plan.cx, plan.cy, plan.radius, angle);
            pts[pts.length] = [p.x - origin[0], p.y - origin[1]];
        }
        return pts;
    }

    /**
     * Tooth outline (WORLD points, converted to local by the caller).
     * Semantics (v1, documented in the shape-builder header):
     *   - {ux,uy} = growth direction ("outward" for circular; the positive
     *     normal side for linear). Tangent (across) = (-uy, ux).
     *   - alignment "outer": base ON the baseline anchor, tip at +h along u.
     *     "inner": tip at -h. "center": straddles the anchor (±h/2).
     *   - square: side = max(width, height) for both dimensions.
     *   - trapezoid: tip width = width / 2 (narrow top).
     *   - triangle: 3 points (base corners + tip).
     */
    function toothPointsWorld(plan, item, teeth) {
        var w = teeth.width, h = teeth.height;
        if (!(typeof w === "number" && isFinite(w) && w > 0)) { w = 0; }
        if (!(typeof h === "number" && isFinite(h) && h > 0)) { h = 0; }
        if (teeth.shape === "square") {
            var side = Math.max(w, h);
            w = side;
            h = side;
        }
        var u = [item.ux, item.uy];
        var tan = [-item.uy, item.ux];
        var ax = item.x, ay = item.y;
        var bx = ax, by = ay, ex = ax, ey = ay;
        if (teeth.alignment === "inner") {
            ex = ax - u[0] * h;
            ey = ay - u[1] * h;
        } else if (teeth.alignment === "center") {
            bx = ax - u[0] * (h / 2);
            by = ay - u[1] * (h / 2);
            ex = ax + u[0] * (h / 2);
            ey = ay + u[1] * (h / 2);
        } else { /* "outer" */
            ex = ax + u[0] * h;
            ey = ay + u[1] * h;
        }
        var hw = w / 2;
        var shape = teeth.shape;
        if (shape === "triangle") {
            return [[bx - tan[0] * hw, by - tan[1] * hw],
                    [bx + tan[0] * hw, by + tan[1] * hw],
                    [ex, ey]];
        }
        var tipHalf = (shape === "trapezoid") ? (w / 4) : hw; /* narrow top */
        return [[bx - tan[0] * hw, by - tan[1] * hw],
                [bx + tan[0] * hw, by + tan[1] * hw],
                [ex + tan[0] * tipHalf, ey + tan[1] * tipHalf],
                [ex - tan[0] * tipHalf, ey - tan[1] * tipHalf]];
    }

    /* ------------------------------ AE builders ---------------------- */

    function setSafeVal(p, v) {
        if (p === null || typeof p !== "object") { return false; }
        try { p.setValue(v); return true; } catch (eS) { return false; }
    }

    /**
     * Centers a text layer: anchorPoint at the visual center of its source
     * rect, position at the planned world point, rotation applied last so it
     * pivots around the text center.
     */
    function placeLabel(sb, layer, anchorXY, posXY, rotationDeg, warnings) {
        var t = sb.prop(layer, "ADBE Transform Group");
        var ap = (t !== null) ? sb.prop(t, "ADBE Anchor Point") : null;
        var pp = (t !== null) ? sb.prop(t, "ADBE Position") : null;
        if (ap === null && typeof layer.anchorPoint !== "undefined") { ap = layer.anchorPoint; }
        if (pp === null && typeof layer.position !== "undefined") { pp = layer.position; }
        if (anchorXY !== null) { setSafeVal(ap, [anchorXY[0], anchorXY[1], 0]); }
        setSafeVal(pp, [posXY[0], posXY[1], 0]);
        if (typeof rotationDeg === "number" && rotationDeg !== 0) {
            if (sb.setLayerRotation(layer, rotationDeg) !== true) {
                warnings.push("Label rotation could not be applied on " + String(layer.name) + ".");
            }
        }
    }

    /* ------------------------------ generate ------------------------- */

    function implGenerate(rawArg) {
        var CFG = configModule();
        var VAL = validationModule();
        var A = ae();
        var sb = A.shapeBuilder;
        var tb = A.textBuilder;
        var cbi = A.controllerBuilder;
        var lm = A.layerManager;
        var MD = A.metadata;
        var compAccess = A.composition;

        /* 1. payload -> cfg -> normalized */
        var cfg = parsePayload(rawArg);
        var normalized = CFG.normalize(cfg);

        /* 2. active comp (guarded; NO_PROJECT / NO_ACTIVE_COMP contract) */
        var comp = compAccess.getActiveComp();
        var compInfo = compAccess.compInfoOf(comp);

        /* 3. AE-aware validation */
        var result = VAL.validateForAE(normalized, compInfo);
        if (result.valid !== true) {
            var total = result.errors.length;
            var first = (total > 0) ? result.errors[0] : null;
            var msg = first
                ? (first.field + ": " + first.message + " (1 of " + total + " error(s).)")
                : "Configuration rejected by validation.";
            throw errData("INVALID_CONFIG", msg, { errors: result.errors });
        }

        /* 4. resolve composition-dependent values */
        var resolved = CFG.resolveAuto(normalized, compInfo);

        /* 5. LayoutPlan (coded errors rethrown verbatim).
         * centerAsPoint converts the schema's array center to the {x, y}
         * shape the frozen geometry core expects (see helper doc). */
        var plan;
        try {
            plan = geometryModule().buildTickPlan(centerAsPoint(resolved), compInfo);
        } catch (ePlan) {
            if (ePlan !== null && typeof ePlan === "object" && typeof ePlan.code === "string") {
                throw ePlan;
            }
            throw err("HOST_EXCEPTION", "buildTickPlan failed: " +
                String(ePlan && ePlan.message ? ePlan.message : ePlan));
        }

        /* 6. next free 4-digit instance id from the comp's metadata scan */
        var instanceId = MD.nextInstanceId(comp);
        if (instanceId === null) {
            throw err("TOO_MANY_INSTANCES",
                "This composition already contains 9999 TIME RULER instances; no free instance id remains.");
        }

        var warnings = [];

        /* 7. the whole AE mutation inside ONE undo group */
        var built = TR.API._withUndo("TIME RULER: Generate", function () {
            return buildInstance(sb, tb, cbi, lm, MD, comp, compInfo, plan, resolved, instanceId, warnings);
        });

        return {
            data: built.data,
            warnings: warnings
        };
    }

    /**
     * Builds every layer for one instance inside an open undo group.
     * Failure cleanup: any exception removes the layers created so far (own
     * layers only, reverse order, guarded) and rethrows the ORIGINAL error;
     * _withUndo's finally closes the undo group.
     */
    function buildInstance(sb, tb, cbi, lm, MD, comp, compInfo, plan, cfg, instanceId, warnings) {
        var createdLayers = [];
        var ctrlLayer = null;
        var counts = { major: 0, minor: 0, micro: 0, labels: 0, teeth: 0 };
        var origin = layerOrigin(plan);

        try {
            /* --- a. CTRL master controller ------------------------------ */
            /* Rig mode ALWAYS gets the controller (spec 9.1: the rig binds
             * every expression to it); output.createMasterController === false
             * is honored in generator mode only and recorded as a warning. */
            var rigMode = (cfg.output && cfg.output.mode === 'rig');
            var wantCtrl = (cfg.output && cfg.output.createMasterController === true) || rigMode;
            if (rigMode && cfg.output.createMasterController !== true) {
                warnings.push('Rig mode requires the master controller.');
            }
            if (wantCtrl) {
                ctrlLayer = cbi.createMaster(comp, 'TR_' + instanceId + '_CTRL_MAIN', origin);
                if (ctrlLayer !== null && typeof ctrlLayer === 'object') {
                    createdLayers[createdLayers.length] = ctrlLayer;
                    var baseComment = MD.writeMetadata(ctrlLayer, instanceId, "CTRL_MAIN", "CONTROLLER");
                    /* CFG snapshot uses the RESOLVED config (truth of what was
                     * built; resolveAuto is idempotent so re-normalizing a
                     * resolved config is a no-op). Budget-guarded: >2000 chars
                     * becomes a truncation-safe omission note. */
                    MD.appendConfigSnapshot(ctrlLayer, baseComment, cfg);
                } else {
                    warnings.push("Controller layer creation failed; ruler built without a controller.");
                    ctrlLayer = null;
                }
            }

            /* --- b. BASE ring / baseline -------------------------------- */
            if (cfg.baseline && cfg.baseline.enabled === true) {
                var baseLayer = sb.newShapeLayer(comp, "TR_" + instanceId + "_BASE_RING", origin);
                if (baseLayer === null) {
                    throw err("HOST_EXCEPTION", "Could not create the baseline layer.");
                }
                createdLayers[createdLayers.length] = baseLayer;
                MD.writeMetadata(baseLayer, instanceId, "BASE_RING", "BASE");
                var baseContents = sb.contentsOf(baseLayer);
                var baseGroup = sb.addVectorGroup(baseContents, (plan.type === "linear") ? "BASELINE" : "RING");
                if (plan.type === "linear") {
                    var b = plan.baseline;
                    sb.setPath(baseGroup, sb.linePath(
                        [b.x1 - origin[0], b.y1 - origin[1]],
                        [b.x2 - origin[0], b.y2 - origin[1]]
                    ));
                } else if (plan.baseline.kind === "circle" ||
                           (plan.type === "circular" && fullCircleIntent(cfg))) {
                    /* Full-circle intent (cyclic sweep, seamGap 0, or bounded
                     * 360 whose seam gap shrank the effective sweep): one
                     * parametric Ellipse path, size [2r, 2r], position [0, 0].
                     * The seam gap shapes tick/label placement, not the ring
                     * outline. A genuinely partial circular sweep falls
                     * through to the sampled arc polyline below. */
                    sb.setEllipse(baseGroup, [plan.radius * 2, plan.radius * 2], [0, 0]);
                } else {
                    /* Arc: sampled Bezier polyline, ≤3° per segment, open. */
                    sb.setPath(baseGroup, sb.polylinePath(sampleBaselineArc(plan, origin), false));
                }
                sb.addStroke(baseGroup, sb.hexToRgb(cfg.baseline.color), cfg.baseline.width, 100,
                    sb.CAP_BUTT, sb.JOIN_MITER);
                sb.disableFill(baseGroup);
            }

            /* --- c. TICKS: one shape layer per enabled level -------------
             * Layer references are snapshotted from createdLayers (each
             * builder adds at most ONE layer at the end) for the rig phase. */
            var lenBefore = createdLayers.length;
            counts.major = buildTickLayer(sb, MD, comp, plan, "MAJOR", "major", cfg, instanceId, origin, createdLayers);
            var majorLayer = (createdLayers.length > lenBefore) ? createdLayers[createdLayers.length - 1] : null;
            lenBefore = createdLayers.length;
            counts.minor = buildTickLayer(sb, MD, comp, plan, "MINOR", "minor", cfg, instanceId, origin, createdLayers);
            var minorLayer = (createdLayers.length > lenBefore) ? createdLayers[createdLayers.length - 1] : null;
            lenBefore = createdLayers.length;
            counts.micro = buildTickLayer(sb, MD, comp, plan, "MICRO", "micro", cfg, instanceId, origin, createdLayers);
            var microLayer = (createdLayers.length > lenBefore) ? createdLayers[createdLayers.length - 1] : null;

            /* --- d. TEETH ------------------------------------------------ */
            if (cfg.teeth && cfg.teeth.enabled === true && plan.teeth && plan.teeth.length > 0) {
                counts.teeth = buildTeethLayer(sb, MD, comp, plan, cfg.teeth, instanceId, origin, createdLayers);
            }

            /* --- e. LABELS ----------------------------------------------- */
            var labelLayers = [];
            if (cfg.typography && cfg.typography.enabled === true && plan.labels.length > 0) {
                lenBefore = createdLayers.length;
                counts.labels = buildLabels(sb, tb, MD, comp, plan, cfg.typography, instanceId, origin, createdLayers, warnings);
                /* The kept-list order maps 1:1 onto the created layers. */
                for (var lIdx = lenBefore; lIdx < createdLayers.length; lIdx++) {
                    labelLayers[labelLayers.length] = createdLayers[lIdx];
                }
            }

            /* --- f. MARKER ------------------------------------------------ */
            var markerLayer = null;
            if (cfg.indicators && cfg.indicators.marker === true) {
                var progressT = progressFraction(cfg);
                var markerPoint = lm.positionAtT(plan, progressT);
                markerLayer = sb.newShapeLayer(comp, "TR_" + instanceId + "_MARKER", [markerPoint.x, markerPoint.y]);
                if (markerLayer === null) {
                    throw err("HOST_EXCEPTION", "Could not create the marker layer.");
                }
                createdLayers[createdLayers.length] = markerLayer;
                MD.writeMetadata(markerLayer, instanceId, "MARKER", "MARKER");
                var markerContents = sb.contentsOf(markerLayer);
                var markerGroup = sb.addVectorGroup(markerContents, "MARKER");
                var markerSize = (cfg.indicators.markerSize > 0) ? cfg.indicators.markerSize : 10;
                sb.setEllipse(markerGroup, [markerSize, markerSize], [0, 0]);
                sb.addFill(markerGroup, sb.hexToRgb(cfg.indicators.markerColor), 100);
                sb.disableStroke(markerGroup);
            }

            /* --- g. PROGRESS (static preview polyline) -------------------- */
            var progressLayer = null;
            if (cfg.indicators && cfg.indicators.progress === true) {
                progressLayer = buildProgressLayer(sb, MD, comp, plan, cfg, instanceId, origin, createdLayers);
            }

            /* --- h. PARENTING (after ALL layers are positioned) ----------- */
            if (ctrlLayer !== null) {
                lm.applyParent(createdLayers, ctrlLayer);
            }

            /* --- k. RIG PHASE (Milestone 5, inside the SAME undo group) ---
             * Envelope honesty: a rig failure NEVER removes the generator
             * layers already built; the exception is caught here, one honest
             * warning is appended and the GENERATOR result is returned with
             * no data.rig field (rig incomplete). Per-step failures inside
             * TR.rig.sequence degrade into warnings and keep the remaining
             * steps running. */
            var rigResult = null;
            if (rigMode === true) {
                if (TR.rig && typeof TR.rig.sequence === 'function') {
                    var keptLabels = (cfg.typography && cfg.typography.enabled === true && plan.labels.length > 0)
                        ? selectLabels(plan, cfg.typography)
                        : [];
                    var rigCtx = {
                        comp: comp,
                        compInfo: compInfo,
                        plan: plan,
                        cfg: cfg,
                        instanceId: instanceId,
                        origin: origin,
                        ctrl: ctrlLayer,
                        marker: markerLayer,
                        progress: progressLayer,
                        tickLayers: { major: majorLayer, minor: minorLayer, micro: microLayer },
                        labelLayers: labelLayers,
                        keptLabels: keptLabels,
                        counts: counts,
                        createdLayers: createdLayers,
                        sb: sb,
                        tb: tb,
                        cbi: cbi,
                        lm: lm,
                        MD: MD
                    };
                    try {
                        rigResult = TR.rig.sequence(rigCtx, warnings);
                    } catch (eRig) {
                        warnings.push('Rig build failed: ' +
                            String(eRig && eRig.message ? eRig.message : eRig) +
                            (eRig && eRig.line ? ' @line ' + eRig.line : ''));
                        rigResult = null;
                    }
                } else {
                    warnings.push('Rig modules not loaded; generator result returned without rig.');
                }
            }
        } catch (eBuild) {
            /* --- j. FAILURE CLEANUP: remove OWN layers only, then rethrow -- */
            for (var i = createdLayers.length - 1; i >= 0; i--) {
                try { lm.safeRemove(createdLayers[i]); } catch (eRm) { /* never mask the original error */ }
            }
            throw eBuild;
        }

        var controllerName = null;
        if (ctrlLayer !== null) {
            try { controllerName = String(ctrlLayer.name); } catch (eN) { controllerName = null; }
        }

        var outData = {
            instanceId: instanceId,
            controllerName: controllerName,
            counts: counts
        };
        if (rigResult !== null) {
            outData.rig = rigResult;
        }

        return {
            data: outData
        };
    }

    function progressFraction(cfg) {
        var p = (cfg.animation && typeof cfg.animation.progress === "number" && isFinite(cfg.animation.progress))
            ? cfg.animation.progress : 0;
        if (p < 0) { p = 0; }
        if (p > 100) { p = 100; }
        return p / 100;
    }

    /**
     * One shape layer per ENABLED level with at least one tick. Empty levels
     * (e.g. minorDivisions < 2 with minors enabled) create NO layer — an
     * empty shape layer in the timeline helps nobody.
     * Element id = MAJOR_TICKS / MINOR_TICKS / MICRO_TICKS, element type
     * TICKS; groups named MAJOR_0001.. inside Contents.
     */
    function buildTickLayer(sb, MD, comp, plan, levelName, levelKey, cfg, instanceId, origin, createdLayers) {
        var level = cfg.graduations ? cfg.graduations[levelKey] : null;
        if (!level || level.enabled !== true) { return 0; }
        var items = plan.items[levelKey];
        if (!items || items.length === 0) { return 0; }

        var layer = sb.newShapeLayer(comp, "TR_" + instanceId + "_" + levelName + "_TICKS", origin);
        if (layer === null) {
            throw err("HOST_EXCEPTION", "Could not create the " + levelName + " ticks layer.");
        }
        createdLayers[createdLayers.length] = layer;
        MD.writeMetadata(layer, instanceId, levelName + "_TICKS", "TICKS");

        var contents = sb.contentsOf(layer);
        var rgb = sb.hexToRgb(level.color);
        var length = (typeof level.length === "number") ? level.length : 0;
        var offset = (typeof level.offset === "number") ? level.offset : 0;
        var prefix = levelName;

        for (var i = 0; i < items.length; i++) {
            var group = sb.addVectorGroup(contents, prefix + "_" + pad4(i + 1));
            var it = items[i];
            var sx = it.x + it.ux * offset - origin[0];
            var sy = it.y + it.uy * offset - origin[1];
            var ex = it.x + it.ux * (offset + length) - origin[0];
            var ey = it.y + it.uy * (offset + length) - origin[1];
            sb.setPath(group, sb.linePath([sx, sy], [ex, ey]));
            sb.addStroke(group, rgb, level.width, level.opacity, sb.CAP_BUTT, sb.JOIN_MITER);
            sb.disableFill(group);
        }
        return items.length;
    }

    /**
     * One closed filled path per tooth, group "TOOTH_0001"... Fill =
     * teeth.color at teeth.opacity, stroke off.
     */
    function buildTeethLayer(sb, MD, comp, plan, teeth, instanceId, origin, createdLayers) {
        var items = plan.teeth;
        var layer = sb.newShapeLayer(comp, "TR_" + instanceId + "_TEETH", origin);
        if (layer === null) {
            throw err("HOST_EXCEPTION", "Could not create the teeth layer.");
        }
        createdLayers[createdLayers.length] = layer;
        MD.writeMetadata(layer, instanceId, "TEETH", "TEETH");

        var contents = sb.contentsOf(layer);
        var rgb = sb.hexToRgb(teeth.color);
        var opacity = (typeof teeth.opacity === "number") ? teeth.opacity : 100;

        for (var i = 0; i < items.length; i++) {
            var group = sb.addVectorGroup(contents, "TOOTH_" + pad4(i + 1));
            var world = toothPointsWorld(plan, items[i], teeth);
            var local = [];
            for (var k = 0; k < world.length; k++) {
                local[local.length] = [world[k][0] - origin[0], world[k][1] - origin[1]];
            }
            sb.setPath(group, sb.polyPath(local));
            sb.addFill(group, rgb, opacity);
            sb.disableStroke(group);
        }
        return items.length;
    }

    /**
     * One SEPARATE editable text layer per kept label, sequential numbering
     * over the kept list: TR_<ID>_LABEL_0001...
     */
    function buildLabels(sb, tb, MD, comp, plan, typo, instanceId, origin, createdLayers, warnings) {
        var kept = selectLabels(plan, typo);
        if (kept.length > LABELS_HARD_CAP) {
            throw errData("TOO_MANY_LABELS",
                "Kept label count (" + kept.length + ") exceeds the generation hard cap (" + LABELS_HARD_CAP + ").",
                { kept: kept.length, cap: LABELS_HARD_CAP });
        }
        var rgb = sb.hexToRgb(typo.color);
        var seq = 0;
        for (var i = 0; i < kept.length; i++) {
            seq = seq + 1;
            var lbl = kept[i];
            var name = "TR_" + instanceId + "_LABEL_" + pad4(seq);
            var made = tb.createLabel(comp, name, lbl.text, {
                fontName: typo.fontName,
                fontSize: typo.fontSize,
                tracking: typo.tracking,
                colorRgb: rgb
            });
            var wj;
            for (wj = 0; wj < made.warnings.length; wj++) { warnings.push(made.warnings[wj]); }
            if (made.layer === null) {
                throw err("HOST_EXCEPTION", "Label layer creation failed for " + name + ".");
            }
            createdLayers[createdLayers.length] = made.layer;
            MD.writeMetadata(made.layer, instanceId, "LABEL_" + pad4(seq), "LABEL");

            /* anchor centering from sourceRectAtTime(now, false) */
            var rect = null;
            try { rect = made.layer.sourceRectAtTime(0, false); } catch (eR) { rect = null; }
            var anchor = null;
            if (rect !== null && typeof rect === "object") {
                anchor = [rect.left + rect.width / 2, rect.top + rect.height / 2];
            } else {
                warnings.push("Could not measure label " + name + " (sourceRectAtTime unavailable); anchor left at default.");
            }
            placeLabel(sb, made.layer, anchor, [lbl.x, lbl.y], labelRotation(plan, lbl, typo), warnings);
        }
        return kept.length;
    }

    /**
     * PROGRESS = static preview of the rig path (the animated rig is
     * Milestone 5): sampled polyline from t=0 to t=progress/100, ≤240 points,
     * stroke = highlightColor, width = max(2, baseline.width*2), round
     * caps/joins. Returns the layer (the rig phase re-fetches its group and
     * REPLACES this truncated path with the full-range polyline + Trim
     * expression; generator mode keeps the static path untouched).
     */
    function buildProgressLayer(sb, MD, comp, plan, cfg, instanceId, origin, createdLayers) {
        var tEnd = progressFraction(cfg);
        var n = Math.max(2, Math.ceil(tEnd * PROGRESS_MAX_POINTS));
        if (n > PROGRESS_MAX_POINTS) { n = PROGRESS_MAX_POINTS; }
        var lm = TR.ae.layerManager;
        var pts = [];
        for (var i = 0; i < n; i++) {
            var t = tEnd * (i / (n - 1));
            var p = lm.positionAtT(plan, t);
            pts[pts.length] = [p.x - origin[0], p.y - origin[1]];
        }
        var layer = sb.newShapeLayer(comp, "TR_" + instanceId + "_PROGRESS", origin);
        if (layer === null) {
            throw err("HOST_EXCEPTION", "Could not create the progress layer.");
        }
        createdLayers[createdLayers.length] = layer;
        MD.writeMetadata(layer, instanceId, "PROGRESS", "PROGRESS");
        var contents = sb.contentsOf(layer);
        var group = sb.addVectorGroup(contents, "PROGRESS");
        sb.setPath(group, sb.polylinePath(pts, false));
        var width = Math.max(2, (cfg.baseline ? cfg.baseline.width : 2) * 2);
        sb.addStroke(group, sb.hexToRgb(cfg.indicators.highlightColor), width, 100,
            sb.CAP_ROUND, sb.JOIN_ROUND);
        sb.disableFill(group);
        return layer;
    }

    /* ------------------------------ listInstances -------------------- */

    function implListInstances() {
        var A = ae();
        var comp = A.composition.getActiveComp();
        var scanned = A.metadata.scanInstances(comp);
        var info = A.composition.compInfoOf(comp);

        var instances = [];
        for (var i = 0; i < scanned.length; i++) {
            var s = scanned[i];
            instances[instances.length] = {
                instanceId: s.instanceId,
                controllerName: s.controllerName,
                elementCounts: s.elementCounts,
                elementTypes: s.elementTypes
            };
        }
        return {
            comp: {
                name: info.name,
                width: info.width,
                height: info.height,
                frameRate: info.frameRate
            },
            instances: instances
        };
    }

    /**
     * Collects all layers belonging to an instance id in `comp`.
     * Returns { ctrl: layer|null, layers: [Layer] (reverse-timeline / top-down) }.
     */
    function findInstanceLayers(comp, MD, targetId) {
        var result = { ctrl: null, layers: [] };
        if (comp === null || typeof comp !== 'object' || !targetId) { return result; }
        var num = 0;
        try { num = comp.numLayers; } catch (eN) { num = 0; }
        for (var i = 1; i <= num; i++) {
            var layer = null;
            try { layer = comp.layer(i); } catch (eL) {
                try { layer = comp.layers[i]; } catch (eL2) { layer = null; }
            }
            if (layer === null || typeof layer !== 'object') { continue; }
            var meta = null;
            try { meta = MD.parseMetadata(layer.comment); } catch (eM) { meta = null; }
            if (meta !== null && meta.instanceId === targetId) {
                result.layers[result.layers.length] = layer;
                if (meta.elementType === 'CONTROLLER' || meta.elementId === 'CTRL_MAIN') {
                    result.ctrl = layer;
                }
            }
        }
        return result;
    }

    /* ------------------------------ update ---------------------------- */

    function implUpdate(rawArg) {
        var CFG = configModule();
        var VAL = validationModule();
        var A = ae();
        var compAccess = A.composition;
        var MD = A.metadata;
        var sb = A.shapeBuilder;

        var payload = parsePayload(rawArg);
        var instanceId = (typeof payload.instanceId === 'string' && payload.instanceId.length > 0)
            ? payload.instanceId
            : (typeof payload.id === 'string' ? payload.id : null);
        if (!instanceId) {
            throw err('MISSING_INSTANCE_ID', "Missing 'instanceId' in update payload.");
        }

        var comp = compAccess.getActiveComp();
        var compInfo = compAccess.compInfoOf(comp);

        var found = findInstanceLayers(comp, MD, instanceId);
        if (found.layers.length === 0) {
            throw err('INSTANCE_NOT_FOUND', "Instance " + instanceId + " not found in the active composition.");
        }

        var inCfg = payload.config || payload;
        var normalized = CFG.normalize(inCfg);
        var result = VAL.validateForAE(normalized, compInfo);
        if (result.valid !== true) {
            var total = result.errors.length;
            var first = (total > 0) ? result.errors[0] : null;
            var msg = first ? (first.field + ": " + first.message) : "Configuration rejected by validation.";
            throw errData("INVALID_CONFIG", msg, { errors: result.errors });
        }
        var resolved = CFG.resolveAuto(normalized, compInfo);
        var warnings = [];

        TR.API._withUndo("TIME RULER: Update " + instanceId, function () {
            var ctrl = found.ctrl;
            if (ctrl !== null) {
                var effects = sb.prop(ctrl, 'ADBE Effect Parade');
                if (effects !== null && resolved.output && resolved.output.mode === 'rig') {
                    var anim = resolved.animation || {};
                    var grad = resolved.graduations || {};
                    var ind = resolved.indicators || {};
                    var typo = resolved.typography || {};

                    function setFx(name, valMatch, val) {
                        var fx = sb.prop(effects, name);
                        if (fx !== null) {
                            var vp = sb.prop(fx, valMatch);
                            if (vp === null) { try { vp = fx.property(1); } catch (e) { vp = null; } }
                            if (vp !== null) { try { vp.setValue(val); } catch (eV) {} }
                        }
                    }

                    setFx('Progress', 'ADBE Slider Control-0001', (typeof anim.progress === 'number') ? anim.progress : 0);
                    setFx('Reveal', 'ADBE Slider Control-0001', (typeof anim.reveal === 'number') ? anim.reveal : 100);
                    setFx('Highlight Start', 'ADBE Slider Control-0001', (typeof anim.highlightStart === 'number') ? anim.highlightStart : 0);
                    setFx('Highlight End', 'ADBE Slider Control-0001', (typeof anim.highlightEnd === 'number') ? anim.highlightEnd : 100);
                    setFx('Rotation Offset', 'ADBE Angle Control-0001', (typeof anim.rotationOffset === 'number') ? anim.rotationOffset : 0);

                    if (grad.major && grad.major.color) {
                        var c1 = sb.hexToRgb(grad.major.color);
                        setFx('Major Color', 'ADBE Color Control-0001', [c1[0], c1[1], c1[2], 1]);
                    }
                    if (grad.minor && grad.minor.color) {
                        var c2 = sb.hexToRgb(grad.minor.color);
                        setFx('Minor Color', 'ADBE Color Control-0001', [c2[0], c2[1], c2[2], 1]);
                    }
                    if (grad.micro && grad.micro.color) {
                        var c3 = sb.hexToRgb(grad.micro.color);
                        setFx('Micro Color', 'ADBE Color Control-0001', [c3[0], c3[1], c3[2], 1]);
                    }
                    if (typo.color) {
                        var c4 = sb.hexToRgb(typo.color);
                        setFx('Label Color', 'ADBE Color Control-0001', [c4[0], c4[1], c4[2], 1]);
                    }
                    if (ind.highlightColor) {
                        var c5 = sb.hexToRgb(ind.highlightColor);
                        setFx('Highlight Color', 'ADBE Color Control-0001', [c5[0], c5[1], c5[2], 1]);
                    }
                    if (ind.markerColor) {
                        var c6 = sb.hexToRgb(ind.markerColor);
                        setFx('Marker Color', 'ADBE Color Control-0001', [c6[0], c6[1], c6[2], 1]);
                    }
                }

                var baseComment = MD.writeMetadata(ctrl, instanceId, 'CTRL_MAIN', 'CONTROLLER');
                MD.appendConfigSnapshot(ctrl, baseComment, resolved);
            }
        });

        return {
            data: {
                instanceId: instanceId,
                controllerName: found.ctrl ? String(found.ctrl.name) : null,
                layerCount: found.layers.length
            },
            warnings: warnings
        };
    }

    /* ------------------------------ regenerate ------------------------ */

    function implRegenerate(rawArg) {
        var CFG = configModule();
        var VAL = validationModule();
        var A = ae();
        var sb = A.shapeBuilder;
        var tb = A.textBuilder;
        var cbi = A.controllerBuilder;
        var lm = A.layerManager;
        var compAccess = A.composition;
        var MD = A.metadata;

        var payload = parsePayload(rawArg);
        var instanceId = (typeof payload.instanceId === 'string' && payload.instanceId.length > 0)
            ? payload.instanceId
            : (typeof payload.id === 'string' ? payload.id : null);
        if (!instanceId) {
            throw err('MISSING_INSTANCE_ID', "Missing 'instanceId' in regenerate payload.");
        }
        if (payload.confirmReplace !== true) {
            throw err('CONFIRMATION_REQUIRED', "Regenerating will replace all managed layers for instance " + instanceId + "; pass confirmReplace: true to proceed.");
        }

        var comp = compAccess.getActiveComp();
        var compInfo = compAccess.compInfoOf(comp);

        var found = findInstanceLayers(comp, MD, instanceId);
        if (found.layers.length === 0) {
            throw err('INSTANCE_NOT_FOUND', "Instance " + instanceId + " not found in the active composition.");
        }

        var inCfg = payload.config;
        if (!inCfg && found.ctrl) {
            inCfg = MD.extractConfigSnapshot(found.ctrl.comment);
        }
        if (!inCfg) {
            throw err('MISSING_CONFIG', "No configuration supplied and no stored snapshot could be read from instance " + instanceId + ".");
        }

        var normalized = CFG.normalize(inCfg);
        var result = VAL.validateForAE(normalized, compInfo);
        if (result.valid !== true) {
            var total = result.errors.length;
            var first = (total > 0) ? result.errors[0] : null;
            var msg = first ? (first.field + ": " + first.message) : "Configuration rejected by validation.";
            throw errData("INVALID_CONFIG", msg, { errors: result.errors });
        }
        var resolved = CFG.resolveAuto(normalized, compInfo);

        var plan;
        try {
            plan = geometryModule().buildTickPlan(centerAsPoint(resolved), compInfo);
        } catch (ePlan) {
            if (ePlan !== null && typeof ePlan === "object" && typeof ePlan.code === "string") {
                throw ePlan;
            }
            throw err("HOST_EXCEPTION", "buildTickPlan failed: " +
                String(ePlan && ePlan.message ? ePlan.message : ePlan));
        }

        var warnings = [];

        var built = TR.API._withUndo("TIME RULER: Regenerate " + instanceId, function () {
            // Remove existing managed layers in reverse timeline order
            for (var i = found.layers.length - 1; i >= 0; i--) {
                try { lm.safeRemove(found.layers[i]); } catch (eRm) {}
            }
            // Rebuild with the EXACT same instanceId
            return buildInstance(sb, tb, cbi, lm, MD, comp, compInfo, plan, resolved, instanceId, warnings);
        });

        return {
            data: built.data,
            warnings: warnings
        };
    }

    /* ------------------------------ detach ---------------------------- */

    function implDetach(rawArg) {
        var A = ae();
        var compAccess = A.composition;
        var MD = A.metadata;

        var payload = parsePayload(rawArg);
        var instanceId = (typeof payload.instanceId === 'string' && payload.instanceId.length > 0)
            ? payload.instanceId
            : (typeof payload.id === 'string' ? payload.id : null);
        if (!instanceId) {
            throw err('MISSING_INSTANCE_ID', "Missing 'instanceId' in detach payload.");
        }

        var comp = compAccess.getActiveComp();
        var found = findInstanceLayers(comp, MD, instanceId);
        if (found.layers.length === 0) {
            throw err('INSTANCE_NOT_FOUND', "Instance " + instanceId + " not found in the active composition.");
        }

        var count = 0;
        TR.API._withUndo("TIME RULER: Detach " + instanceId, function () {
            for (var i = 0; i < found.layers.length; i++) {
                try {
                    found.layers[i].comment = "";
                    count++;
                } catch (eC) {}
            }
        });

        return {
            instanceId: instanceId,
            detachedLayersCount: count
        };
    }

    /* ------------------------------ getInstanceConfig ----------------- */

    function implGetInstanceConfig(rawArg) {
        var A = ae();
        var compAccess = A.composition;
        var MD = A.metadata;

        var payload = parsePayload(rawArg);
        var instanceId = (typeof payload.instanceId === 'string' && payload.instanceId.length > 0)
            ? payload.instanceId
            : (typeof payload.id === 'string' ? payload.id : null);
        if (!instanceId) {
            throw err('MISSING_INSTANCE_ID', "Missing 'instanceId' in payload.");
        }

        var comp = compAccess.getActiveComp();
        var found = findInstanceLayers(comp, MD, instanceId);
        if (found.layers.length === 0) {
            throw err('INSTANCE_NOT_FOUND', "Instance " + instanceId + " not found in the active composition.");
        }

        var cfg = null;
        if (found.ctrl !== null) {
            cfg = MD.extractConfigSnapshot(found.ctrl.comment);
        }

        return {
            instanceId: instanceId,
            config: cfg
        };
    }

    /* ------------------------------ public methods ------------------- */

    /* update / regenerate / detach: Milestone 6 (instance management). */
    api.update = function (rawArg) {
        return safeRunWithWarnings(implUpdate, rawArg, "TIME RULER instance updated.");
    };
    api.regenerate = function (rawArg) {
        return safeRunWithWarnings(implRegenerate, rawArg, "TIME RULER instance regenerated.");
    };
    api.detach = function (rawArg) {
        return safeRun(implDetach, rawArg, "TIME RULER instance detached.");
    };
    api.getInstanceConfig = function (rawArg) {
        return safeRun(implGetInstanceConfig, rawArg, "TIME RULER instance configuration.");
    };

    /* generate: dynamic envelope.warnings (font fallback etc.), so the impl
     * returns {data, warnings} like validateConfig's runner. */
    api.generate = function (rawArg) {
        return safeRunWithWarnings(implGenerate, rawArg, "TIME RULER instance generated.");
    };
    api.listInstances = function (rawArg) {
        return safeRun(implListInstances, rawArg, "TIME RULER instances in the active composition.");
    };

    api._withUndo = withUndo;

    return api;
})();

/**
 * TR.dispatch: safe dispatcher for CSInterface.evalScript calls.
 */
TR.dispatch = function (fnName, jsonArg) {
    try {
        if (!TR.ready && typeof TR.boot === "function") {
            TR.boot();
        }
        if (!TR.API || typeof TR.API[fnName] !== "function") {
            var missingPayload = {
                ok: false,
                code: "HOST_NOT_READY",
                message: "Method TIME_RULER.API." + String(fnName) + " is not ready.",
                data: TR.loadErrors ? { loadErrors: TR.loadErrors } : null,
                warnings: []
            };
            return (TR.JSON && typeof TR.JSON.stringify === "function")
                ? TR.JSON.stringify(missingPayload)
                : '{"ok":false,"code":"HOST_NOT_READY","message":"Host engine not ready.","data":null,"warnings":[]}';
        }
        return TR.API[fnName](jsonArg);
    } catch (eDispatch) {
        var msg = String(eDispatch && eDispatch.message ? eDispatch.message : eDispatch) +
            (eDispatch && eDispatch.line ? " @line " + eDispatch.line : "");
        var errPayload = {
            ok: false,
            code: "HOST_EXCEPTION",
            message: msg,
            data: null,
            warnings: []
        };
        return (TR.JSON && typeof TR.JSON.stringify === "function")
            ? TR.JSON.stringify(errPayload)
            : '{"ok":false,"code":"HOST_EXCEPTION","message":"Host exception.","data":null,"warnings":[]}';
    }
};
