// ============================================================================
// TIME RULER — Rig: Highlight layer (ExtendScript ES3)
// ============================================================================
// Module: TR.rig.highlight
// Environment: After Effects 2023+ (ExtendScript ES3). Expression STRINGS
// come only from TR.ae.expressions (spec 9.6).
//
// LAYER (rig mode only, when indicators.highlight === true): shape layer
// TR_<ID>_HIGHLIGHT at the same origin/parenting as the other element
// layers — full-range baseline polyline (TR.rig.progress.fullRangePath:
// <=3 deg/segment circular sampling, full line for linear, effective sweep
// incl. seam gap, closed for cyclic circles), stroke = highlightColor,
// width = max(3, baseline.width*2), round caps/joins, fill disabled.
//
// ANIMATION: Trim Paths ("ADBE Vector Filter - Trim") with Start/End bound
// to the Highlight Start/End sliders (static fallback values = the
// configured defaults so a disabled expression still shows the range).
// Metadata element id/type: HIGHLIGHT|HIGHLIGHT (extends the M3 registry
// vocabulary; scanInstances counts it additively).
//
// ES3 rules: var only, classic loops, try/catch, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.rig = TR.rig || {};
TR.rig.highlight = (function () {

    var TRIM_MN = 'ADBE Vector Filter - Trim';
    var TRIM_START_MN = 'ADBE Vector Trim Start';
    var TRIM_END_MN = 'ADBE Vector Trim End';

    function num(v, def) {
        return (typeof v === 'number' && isFinite(v)) ? v : def;
    }

    function setVal(p, v) {
        if (p === null || typeof p !== 'object') { return false; }
        try { p.setValue(v); return true; } catch (eS) { return false; }
    }

    function safeName(layer) {
        try { return String(layer.name); } catch (eN) { return ''; }
    }

    function apply(ctx, warnings) {
        var sb = ctx.sb;
        var MD = ctx.MD;
        var lm = ctx.lm;
        var EX = TR.ae.expressions;
        var ind = ctx.cfg.indicators || {};
        if (ind.highlight !== true) { return { applied: false, expressions: 0 }; }
        if (!EX) { return { applied: false, expressions: 0 }; }
        var ctrlName = safeName(ctx.ctrl);

        var layer = sb.newShapeLayer(ctx.comp, 'TR_' + ctx.instanceId + '_HIGHLIGHT', ctx.origin);
        if (layer === null) {
            warnings.push('Rig: highlight layer creation failed.');
            return { applied: false, expressions: 0 };
        }
        MD.writeMetadata(layer, ctx.instanceId, 'HIGHLIGHT', 'HIGHLIGHT');

        var contents = sb.contentsOf(layer);
        var group = sb.addVectorGroup(contents, 'HIGHLIGHT');
        if (!group) {
            warnings.push('Rig: HIGHLIGHT group could not be added.');
            return { applied: false, expressions: 0 };
        }

        /* Full-range baseline polyline (shared sampler with the progress rig). */
        var fr = TR.rig.progress.fullRangePath(ctx.plan, ctx.origin);
        if (!fr.pts || fr.pts.length < 2) {
            warnings.push('Rig: highlight path sampling failed.');
            return { applied: false, expressions: 0 };
        }
        sb.setPath(group, sb.polylinePath(fr.pts, fr.closed));

        var baseWidth = num(ctx.cfg.baseline ? ctx.cfg.baseline.width : 2, 2);
        sb.addStroke(group, sb.hexToRgb(ind.highlightColor || '#F2A33C'),
            Math.max(3, baseWidth * 2), 100, sb.CAP_ROUND, sb.JOIN_ROUND);
        sb.disableFill(group);

        /* Trim Start/End bound to the Highlight Start/End sliders. */
        var trim = sb.ensureProp(group, TRIM_MN);
        var anim = ctx.cfg.animation || {};
        var count = 0;
        if (trim !== null) {
            var trimStart = sb.prop(trim, TRIM_START_MN);
            var trimEnd = sb.prop(trim, TRIM_END_MN);
            setVal(trimStart, num(anim.highlightStart, 0));
            setVal(trimEnd, num(anim.highlightEnd, 100));
            if (trimStart) {
                if (EX.applyExpression(trimStart,
                    EX.highlightTrimStartExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName }),
                    warnings, 'HIGHLIGHT trim Start')) { count++; }
            }
            if (trimEnd) {
                if (EX.applyExpression(trimEnd,
                    EX.highlightTrimEndExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName }),
                    warnings, 'HIGHLIGHT trim End')) { count++; }
            }
        } else {
            warnings.push('Rig: Trim Paths could not be added to HIGHLIGHT.');
        }

        /* Stroke color -> Highlight Color control. */
        var stroke = sb.prop(group, 'ADBE Vector Graphic - Stroke');
        var strokeColor = stroke ? sb.prop(stroke, 'ADBE Vector Stroke Color') : null;
        if (strokeColor) {
            if (EX.applyExpression(strokeColor,
                EX.colorBindExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName, effectName: 'Highlight Color' }),
                warnings, 'HIGHLIGHT stroke color bind')) { count++; }
        }

        /* Same parenting rule as the M3 layers (parent LAST, world kept). */
        if (ctx.ctrl) { lm.applyParent([layer], ctx.ctrl); }

        return { applied: true, expressions: count, layer: layer };
    }

    return { apply: apply };
})();
