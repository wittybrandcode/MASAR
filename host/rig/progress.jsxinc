// ============================================================================
// TIME RULER — Rig: Progress path + Style binds + Sequence (ExtendScript ES3)
// ============================================================================
// Module: TR.rig (namespace created here) + TR.rig.progress / TR.rig.style /
// TR.rig.controllers / TR.rig.sequence.
// Environment: After Effects 2023+ (ExtendScript ES3). AE DOM access stays in
// host/ae/* modules; rig modules consume them (and TR.ae.expressions, the
// single source of expression strings — no raw expression literals here).
//
// FILE RESPONSIBILITIES (M5 module map):
//   rig/progress.jsxinc  TR.rig.progress (path+trim) / TR.rig.style (color
//                        binds for ticks+labels) / TR.rig.controllers
//                        (11 effects) / TR.rig.sequence (orchestrator)
//   rig/marker.jsxinc    TR.rig.marker (position expr + Marker Color fill)
//                        / TR.rig.rotation (CTRL rotation expr)
//   rig/reveal.jsxinc    TR.rig.reveal (staggered group/label opacity)
//   rig/counter.jsxinc   TR.rig.counter (numeric expr / hold keyframes)
//   rig/highlight.jsxinc TR.rig.highlight (HIGHLIGHT layer + trim exprs)
//
// SEQUENCE ORDER (spec 9 + task): controllers FIRST (effects must exist for
// the expressions to resolve), then marker -> progress -> highlight ->
// reveal -> counter -> rotation -> style binds. Per step: one try/catch —
// a failing step appends "Rig step '<name>' failed: ..." and the remaining
// steps still run (isolation); the phase itself is additionally wrapped by
// api.jsxinc ("Rig build failed: ..." envelope honesty).
//
// PROGRESS PATH DECISION (rig mode): the M3 static truncated preview polyline
// is REPLACED with a FULL-RANGE baseline polyline (same sampling rules as the
// M3 arc: <= 3 deg/segment; linear = 2 points; circular bounded = t 0..1 over
// the EFFECTIVE sweep incl. the seam gap; cyclic full circle closed) and a
// Trim Paths ("ADBE Vector Filter - Trim") End expression drives it from the
// Progress slider. Generator mode keeps the M3 truncated path UNTOUCHED and
// adds no Trim/effect at all (spec-critical: generator stays expression- and
// effect-free) — there the truncation IS the static visualization.
//
// STYLE BINDS (TR.rig.style): tick stroke colors bind to Major/Minor/Micro
// Color, label fills bind to Label Color via the self-guarding style
// expression (AE 23.x+). PROGRESS + HIGHLIGHT strokes bind to Highlight
// Color inside their own modules; the MARKER fill binds to Marker Color in
// rig/marker.jsxinc. BASE_RING and TEETH stay static (not part of the
// style-control contract). The COUNTER keeps a STATIC fill (decision: its
// Source Text already carries the numeric expression or hold keyframes;
// chaining computed text + style setters is the most fragile corner of the
// expression engine) — flagged in README + manual matrix.
//
// ES3 rules: var only, classic loops, try/catch, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.rig = TR.rig || {};
TR.rig.progress = (function () {

    /* Mirrors api.jsxinc ARC_STEP_DEG (M3 baseline sampling rule: <=3 deg). */
    var ARC_STEP_DEG = 3;
    var TRIM_MN = 'ADBE Vector Filter - Trim';
    var TRIM_START_MN = 'ADBE Vector Trim Start';
    var TRIM_END_MN = 'ADBE Vector Trim End';

    function num(v, def) {
        return (typeof v === 'number' && isFinite(v)) ? v : def;
    }

    function setVal(p, v) {
        if (p === null || typeof p !== 'object') { return false; }
        try { p.setValue(v); return true; } catch (eS) { return false; }
    }

    function safeName(layer) {
        try { return String(layer.name); } catch (eN) { return ''; }
    }

    // ------------------------------------------------------------ full range

    /**
     * Full-range baseline polyline in layer-local coords: {pts, closed}.
     * linear: 2 points (start -> end). circular/arc: sampled via
     * layerManager.positionAtT (respects direction + effective sweep).
     * closed only for a true cyclic circle (baseline.kind "circle"), where
     * the last vertex is omitted and the shape closure connects it.
     */
    function fullRangePath(plan, origin) {
        var lm = (TR.ae && TR.ae.layerManager) ? TR.ae.layerManager : null;
        if (plan && plan.type === 'linear') {
            var b = plan.baseline;
            return {
                pts: [[b.x1 - origin[0], b.y1 - origin[1]], [b.x2 - origin[0], b.y2 - origin[1]]],
                closed: false
            };
        }
        var steps = Math.max(2, Math.ceil(Math.abs(num(plan.sweep, 360)) / ARC_STEP_DEG));
        var isClosed = (plan.type === 'circular' && plan.baseline && plan.baseline.kind === 'circle');
        var last = isClosed ? steps - 1 : steps;
        var pts = [];
        var i, t, p;
        for (i = 0; i <= last; i++) {
            t = i / steps;
            p = lm ? lm.positionAtT(plan, t) : null;
            if (p === null) { return { pts: [], closed: false }; }
            pts[pts.length] = [p.x - origin[0], p.y - origin[1]];
        }
        return { pts: pts, closed: isClosed };
    }

    // ----------------------------------------------------------------- apply

    /**
     * Rig mode PROGRESS: replace the static truncated path with the
     * full-range polyline, add Trim Paths, bind End -> Progress slider
     * (static End fallback = the configured default progress) and bind the
     * stroke color to the Highlight Color control.
     */
    function apply(ctx, warnings) {
        var sb = ctx.sb;
        var EX = TR.ae.expressions;
        var layer = ctx.progress;
        if (!layer) { return { applied: false, expressions: 0 }; }
        var ctrlName = safeName(ctx.ctrl);

        /* Re-fetch references after the M3 build (invalidation rule). */
        var contents = sb.contentsOf(layer);
        var group = contents ? sb.prop(contents, 'PROGRESS') : null;
        if (!group) {
            warnings.push('Rig: PROGRESS group not found; path not replaced.');
            return { applied: false, expressions: 0 };
        }

        var fr = fullRangePath(ctx.plan, ctx.origin);
        if (!fr.pts || fr.pts.length < 2) {
            warnings.push('Rig: full-range progress path sampling failed.');
            return { applied: false, expressions: 0 };
        }
        sb.setPath(group, sb.polylinePath(fr.pts, fr.closed));

        var trim = sb.ensureProp(group, TRIM_MN);
        if (trim === null) {
            warnings.push('Rig: Trim Paths could not be added to PROGRESS.');
            return { applied: false, expressions: 0 };
        }
        var anim = ctx.cfg.animation || {};
        var trimStart = sb.prop(trim, TRIM_START_MN);
        var trimEnd = sb.prop(trim, TRIM_END_MN);
        /* Static fallbacks used only when the expressions are disabled. */
        setVal(trimStart, 0);
        setVal(trimEnd, num(anim.progress, 0));

        var count = 0;
        if (trimEnd && EX) {
            if (EX.applyExpression(trimEnd,
                EX.progressTrimEndExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName }),
                warnings, 'PROGRESS trim End')) { count++; }
        }

        /* Stroke color -> Highlight Color control. */
        var stroke = sb.prop(group, 'ADBE Vector Graphic - Stroke');
        var strokeColor = stroke ? sb.prop(stroke, 'ADBE Vector Stroke Color') : null;
        if (strokeColor && EX) {
            if (EX.applyExpression(strokeColor,
                EX.colorBindExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName, effectName: 'Highlight Color' }),
                warnings, 'PROGRESS stroke color bind')) { count++; }
        }
        return { applied: true, expressions: count };
    }

    var api = {
        ARC_STEP_DEG: ARC_STEP_DEG,
        fullRangePath: fullRangePath,
        apply: apply
    };

    return api;
})();

/* ========================================================================== */
/* TR.rig.style — color binds for ticks + labels (PROGRESS/HIGHLIGHT/MARKER   */
/* binds live in the modules that own those elements).                        */
/* ========================================================================== */
TR.rig.style = (function () {

    function safeName(layer) {
        try { return String(layer.name); } catch (eN) { return ''; }
    }

    /**
     * Binds every tick group's stroke color to its level's Color control and
     * every label layer's Source Text to the Label Color style expression.
     */
    function apply(ctx, warnings) {
        var sb = ctx.sb;
        var tb = ctx.tb;
        var EX = TR.ae.expressions;
        var ctrlName = safeName(ctx.ctrl);
        var count = 0;
        if (!EX) { return { applied: false, expressions: 0 }; }

        var levels = [
            ['major', 'Major Color'],
            ['minor', 'Minor Color'],
            ['micro', 'Micro Color']
        ];
        var li, layer, contents, nProps, gi, group, stroke, strokeColor, effName;

        for (li = 0; li < levels.length; li++) {
            layer = ctx.tickLayers ? ctx.tickLayers[levels[li][0]] : null;
            if (!layer) { continue; }
            effName = levels[li][1];
            contents = sb.contentsOf(layer);
            nProps = 0;
            try { nProps = contents.numProperties; } catch (eN) { nProps = 0; }
            for (gi = 1; gi <= nProps; gi++) {
                group = null;
                try { group = contents.property(gi); } catch (eG) { group = null; }
                if (!group) { continue; }
                stroke = sb.prop(group, 'ADBE Vector Graphic - Stroke');
                strokeColor = stroke ? sb.prop(stroke, 'ADBE Vector Stroke Color') : null;
                if (strokeColor) {
                    if (EX.applyExpression(strokeColor,
                        EX.colorBindExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName, effectName: effName }),
                        warnings, 'tick stroke color bind')) { count++; }
                }
            }
        }

        /* Labels: style color expression (self-guarding, AE 23.x+). */
        var labels = ctx.labelLayers || [];
        for (li = 0; li < labels.length; li++) {
            if (!labels[li]) { continue; }
            var src = tb.sourceTextProp(labels[li]);
            if (src) {
                if (EX.applyExpression(src,
                    EX.labelStyleColorExpr({ instanceId: ctx.instanceId, ctrlName: ctrlName, effectName: 'Label Color' }),
                    warnings, 'label style color bind')) { count++; }
            }
        }
        return { applied: true, expressions: count };
    }

    return { apply: apply };
})();

/* ========================================================================== */
/* TR.rig.controllers — the 11 CTRL effects (spec 9.1: 5 main + 6 style).     */
/* ========================================================================== */
TR.rig.controllers = (function () {

    function num(v, def) {
        return (typeof v === 'number' && isFinite(v)) ? v : def;
    }

    function safeHex(v, def) {
        return (typeof v === 'string' && v.length > 0) ? v : def;
    }

    /**
     * Creates the controller effects in spec order. Returns the list of
     * successfully created effect NAMES (the data.rig.controllers payload).
     */
    function apply(ctx, warnings) {
        var cbi = (TR.ae && TR.ae.controllerBuilder) ? TR.ae.controllerBuilder : null;
        if (!cbi || typeof cbi.createSlider !== 'function') {
            warnings.push('Rig: controllerBuilder effect helpers are not loaded.');
            return [];
        }
        var ctrl = ctx.ctrl;
        if (!ctrl) { return []; }
        var cfg = ctx.cfg;
        var anim = cfg.animation || {};
        var grad = cfg.graduations || {};
        var ind = cfg.indicators || {};
        var typo = cfg.typography || {};
        var names = [];

        function slider(name, def) {
            var fx = cbi.createSlider(ctrl, name, def);
            if (fx) { names[names.length] = name; }
            else { warnings.push('Rig: slider "' + name + '" could not be created.'); }
        }
        function color(name, hex) {
            var fx = cbi.createColorControl(ctrl, name, hex);
            if (fx) { names[names.length] = name; }
            else { warnings.push('Rig: color control "' + name + '" could not be created.'); }
        }

        /* Main controls (defaults from cfg.animation). */
        slider('Progress', num(anim.progress, 0));
        slider('Reveal', num(anim.reveal, 100));
        slider('Highlight Start', num(anim.highlightStart, 0));
        slider('Highlight End', num(anim.highlightEnd, 100));
        var ang = cbi.createAngle(ctrl, 'Rotation Offset', num(anim.rotationOffset, 0));
        if (ang) { names[names.length] = 'Rotation Offset'; }
        else { warnings.push('Rig: angle control "Rotation Offset" could not be created.'); }

        /* Style controls (defaults from the resolved cfg colors). */
        color('Major Color', safeHex(grad.major ? grad.major.color : null, '#2878D0'));
        color('Minor Color', safeHex(grad.minor ? grad.minor.color : null, '#75A9E8'));
        color('Micro Color', safeHex(grad.micro ? grad.micro.color : null, '#A9C7EA'));
        color('Label Color', safeHex(typo.color, '#2878D0'));
        color('Highlight Color', safeHex(ind.highlightColor, '#F2A33C'));
        color('Marker Color', safeHex(ind.markerColor, '#FFFFFF'));
        return names;
    }

    return { apply: apply };
})();

/* ========================================================================== */
/* TR.rig.sequence — orchestrator (called by api.jsxinc inside the SAME undo  */
/* group as the generator build).                                             */
/* ========================================================================== */
TR.rig.sequence = (function () {

    /**
     * ctx: { comp, compInfo, plan, cfg, instanceId, origin, ctrl, marker,
     *        progress, tickLayers:{major,minor,micro}, labelLayers,
     *        keptLabels, counts, sb, tb, cbi, lm, MD }
     * Returns { controllers:[names], expressionsApplied:n, keyframedCounter }.
     */
    function sequence(ctx, warnings) {
        var result = { controllers: [], expressionsApplied: 0, keyframedCounter: false };
        if (!ctx || !ctx.ctrl) {
            warnings.push('Rig skipped: no controller layer.');
            return result;
        }
        var EX = TR.ae.expressions;
        var cbi = TR.ae.controllerBuilder;
        if (!EX || !cbi) {
            warnings.push('Rig modules incomplete (TR.ae.expressions / effect helpers); check bootstrap loadErrors.');
            return result;
        }

        var steps = [
            ['controllers', TR.rig.controllers],
            ['marker', TR.rig.marker],
            ['progress', TR.rig.progress],
            ['highlight', TR.rig.highlight],
            ['reveal', TR.rig.reveal],
            ['counter', TR.rig.counter],
            ['rotation', TR.rig.rotation],
            ['style', TR.rig.style]
        ];
        var i, mod, out;
        for (i = 0; i < steps.length; i++) {
            mod = steps[i][1];
            if (!mod || typeof mod.apply !== 'function') {
                warnings.push('Rig step "' + steps[i][0] + '" unavailable (module missing).');
                continue;
            }
            try {
                out = mod.apply(ctx, warnings);
                if (out && typeof out.expressions === 'number') {
                    result.expressionsApplied = result.expressionsApplied + out.expressions;
                }
                if (steps[i][0] === 'controllers' && out && out.length) {
                    result.controllers = out;
                }
                if (steps[i][0] === 'counter' && out && out.keyframed === true) {
                    result.keyframedCounter = true;
                }
                if (ctx.createdLayers && out && out.layer) {
                    ctx.createdLayers[ctx.createdLayers.length] = out.layer;
                }
            } catch (eStep) {
                warnings.push('Rig step "' + steps[i][0] + '" failed: ' +
                    String(eStep && eStep.message ? eStep.message : eStep));
            }
        }
        return result;
    }

    return sequence;
})();
