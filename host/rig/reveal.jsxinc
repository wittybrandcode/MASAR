// ============================================================================
// TIME RULER — Rig: Reveal (staggered fade by normalized position) (ES3)
// ============================================================================
// Module: TR.rig.reveal
// Environment: After Effects 2023+ (ExtendScript ES3). Expression STRINGS
// come only from TR.ae.expressions (spec 9.6).
//
// BEHAVIOR (spec 9.3): Reveal 0% = everything hidden, Reveal 100% = revealed;
// each element fades in when Reveal crosses its normalized position t
// (opacity = clamp((Reveal - t*100)*20, 0, 100) — a 5-unit-wide ramp, i.e. a
// simple stagger; see the KNOWN EDGE note in the expression-builder header
// for the t > 0.95 tail of the ramp).
//
// APPLIED TO (v1 scope): tick GROUPS on the MAJOR/MINOR/MICRO layers
// ("ADBE Vector Group Opacity" inside each group's auto "ADBE Vector
// Transform Group") and KEPT label layers (transform opacity). Group index i
// maps 1:1 to plan.items.<level>[i] (M3 builds one group per item in order);
// kept labels map positionally to the kept list (labelEvery + collision
// filtering already applied, so labels use their own t values). TEETH and
// BASE layers are NOT revealed (out of the v1 scope, documented).
//
// DENSITY CAP: per-item expressions scale with item count; to avoid
// expression explosion on dense rulers the whole reveal step is SKIPPED when
// tick items + kept labels exceed REVEAL_MAX_ITEMS (600) and one honest
// warning is recorded: "Reveal simplified for dense ruler (N items)".
//
// ES3 rules: var only, classic loops, try/catch, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.rig = TR.rig || {};
TR.rig.reveal = (function () {

    /* Groups + labels above this total get NO per-item reveal expressions. */
    var REVEAL_MAX_ITEMS = 600;

    function safeName(layer) {
        try { return String(layer.name); } catch (eN) { return ''; }
    }

    /** Group transform opacity property (auto transform group inside). */
    function groupOpacityProp(sb, group) {
        var tg = sb.prop(group, 'ADBE Vector Transform Group');
        return (tg !== null) ? sb.prop(tg, 'ADBE Vector Group Opacity') : null;
    }

    /** Layer transform opacity property. */
    function layerOpacityProp(sb, layer) {
        var t = sb.prop(layer, 'ADBE Transform Group');
        var o = (t !== null) ? sb.prop(t, 'ADBE Opacity') : null;
        if (o === null && typeof layer.opacity !== 'undefined') { o = layer.opacity; }
        return o;
    }

    function apply(ctx, warnings) {
        var sb = ctx.sb;
        var EX = TR.ae.expressions;
        var ctrlName = safeName(ctx.ctrl);
        var plan = ctx.plan;
        if (!EX) { return { applied: false, expressions: 0, skipped: true }; }

        var counts = ctx.counts || { major: 0, minor: 0, micro: 0, labels: 0 };
        var total = (counts.major || 0) + (counts.minor || 0) + (counts.micro || 0) +
            (counts.labels || 0);

        if (total > REVEAL_MAX_ITEMS) {
            warnings.push('Reveal simplified for dense ruler (' + total + ' items).');
            return { applied: false, expressions: 0, skipped: true };
        }

        var count = 0;
        var levels = ['major', 'minor', 'micro'];
        var li, layer, items, contents, nProps, group, opProp, expr, item;

        for (li = 0; li < levels.length; li++) {
            layer = ctx.tickLayers ? ctx.tickLayers[levels[li]] : null;
            if (!layer) { continue; }
            items = (plan && plan.items && plan.items[levels[li]]) ? plan.items[levels[li]] : [];
            contents = sb.contentsOf(layer);
            nProps = 0;
            try { nProps = contents.numProperties; } catch (eN) { nProps = 0; }
            for (var gi = 1; gi <= nProps; gi++) {
                group = null;
                try { group = contents.property(gi); } catch (eG) { group = null; }
                if (!group) { continue; }
                opProp = groupOpacityProp(sb, group);
                if (!opProp) { continue; }
                item = items[gi - 1]; /* group i <-> item i (M3 build order) */
                expr = EX.revealOpacityExpr({
                    instanceId: ctx.instanceId,
                    ctrlName: ctrlName,
                    t: item ? item.t : 0
                });
                if (EX.applyExpression(opProp, expr, warnings, 'reveal group opacity')) { count++; }
            }
        }

        /* Kept labels (positional mapping to labelLayers, see header). */
        var labels = ctx.labelLayers || [];
        var kept = ctx.keptLabels || [];
        for (var k = 0; k < labels.length; k++) {
            if (!labels[k]) { continue; }
            var lo = layerOpacityProp(sb, labels[k]);
            if (!lo) { continue; }
            var lbl = kept[k];
            expr = EX.revealOpacityExpr({
                instanceId: ctx.instanceId,
                ctrlName: ctrlName,
                t: lbl ? lbl.t : 0
            });
            if (EX.applyExpression(lo, expr, warnings, 'reveal label opacity')) { count++; }
        }
        return { applied: true, expressions: count, skipped: false };
    }

    return {
        REVEAL_MAX_ITEMS: REVEAL_MAX_ITEMS,
        apply: apply
    };
})();
