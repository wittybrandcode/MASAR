// ============================================================================
// TIME RULER — Core Geometry Engine (ExtendScript ES3, pure math)
// ============================================================================
// Module: TR.core.geometry
// Environment: After Effects 2023+ (ExtendScript ES3) AND Node 22 (test harness).
// PURE MATH ONLY: no `app`, no DOM, no alert, no #include, no AE APIs.
//
// LayoutPlan CONTRACT (consumed by the AE-adapter lane — do not break):
//
//   Circular / Arc rulers:
//   {
//     type: "circular" | "arc",        // mirrors cfg.geometry.type
//     cx, cy, radius,                  // resolved numbers
//     startAngle, sweep, direction,    // sweep = EFFECTIVE sweep (see below)
//     baseline: { kind: "arc"|"circle", cx, cy, radius, startAngle, sweep },
//     items: {
//       major: [{index, t, angleDeg, x, y, ux, uy}],
//       minor: [{index, t, angleDeg, x, y, ux, uy}],
//       micro: [{index, t, angleDeg, x, y, ux, uy}]
//     },
//     labels: [{index, t, angleDeg, x, y, ux, uy, text}]
//   }
//
//   Linear rulers:
//   {
//     type: "linear",
//     baseline: { kind: "line", x1, y1, x2, y2 },
//     items: {
//       major: [{index, t, x, y, ux, uy}],
//       minor: [{index, t, x, y, ux, uy}],
//       micro: [{index, t, x, y, ux, uy}]
//     },
//     labels: [{index, t, x, y, ux, uy, text}]
//   }
//
//   Optional extension (adapter may ignore): teeth: null | [{index,t,angleDeg?,x,y,ux,uy}]
//
//   Contract rules:
//   - Screen coords: Y grows DOWN (After Effects). -90 deg = top of circle.
//   - Positive angle increase = clockwise VISUALLY: x = cx + r*cos(a), y = cy + r*sin(a).
//   - Tick {x,y} = anchor point ON the baseline (ring or line).
//   - {ux,uy} = direction the tick extends (outward for outer alignment).
//     Offsets (graduations.*.offset, lengths) are applied by the AE adapter.
//   - Circular labels sit along the outward unit vector at
//     radius + typography.radiusOffset. Linear labels sit at
//     geometry.labelOffset distance from the line, on the tick side
//     (positive side unless tickSide==="negative"; "both" -> positive).
//     typography.radiusOffset is circular-only in this engine version.
//   - Label text = TR.core.numericTime.format(majorValue, cfg.time).
//   - Label rotation/orientation (radial/tangential/auto upright) is applied
//     by the ADAPTER; the engine only supplies geometry + unit vectors.
//   - direction: "clockwise"      -> angle = startAngle + t * effectiveSweep
//                "counter_clockwise" -> angle = startAngle - t * effectiveSweep
//     t is ALWAYS ascending 0..1 with ascending index.
//   - t in the plan is VALUE-BASED (value position inside the time domain):
//     t = (value - start)/span (bounded) or t = i/count (cyclic).
//     For divisible ranges this equals the index-based i/(count-1) of the
//     pure distributors; for non-divisible bounded ranges it is geometrically
//     truthful (last full-step major does NOT sit at the baseline end).
//   - Angles are raw (not normalized); adapter may mod 360 for display.
//   - Minor ticks: minorDivisions = n equal sub-intervals between two majors,
//     i.e. n-1 internal minor marks per interval (spec 2.4; n >= 2 else none).
//     Minors are placed on the uniform grid value = start +/- k*(step/n),
//     skipping positions that coincide with major marks.
//   - Micro ticks: microDivisions = m between minor marks (m >= 2, only when
//     minor enabled and n >= 2): grid value = start +/- k*(step/(n*m)),
//     skipping positions that coincide with minor/major marks.
//   - Seam: bounded distribution with sweep >= 360 uses
//     effectiveSweep = sweep - seamGapDegrees (default 6). Cyclic ignores seam.
//   - The engine performs NO density capping (spec 11.1 caps live in the
//     validation lane); buildTickPlan computes whatever it is given.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.core = TR.core || {};
TR.core.geometry = (function () {

    var EPS = 1e-9;
    var DEFAULT_SEAM_GAP = 6;
    var DEFAULT_RADIUS = 200;
    var DEFAULT_LABEL_OFFSET = 12;

    // ------------------------------------------------------------------ math

    function degToRad(d) {
        return d * Math.PI / 180;
    }

    function pointOnCircle(cx, cy, radius, angleDeg) {
        var a = degToRad(angleDeg);
        return {
            x: cx + radius * Math.cos(a),
            y: cy + radius * Math.sin(a)
        };
    }

    // Unit outward radial vector = {cos, sin} in screen coords (y down).
    function outVector(angleDeg) {
        var a = degToRad(angleDeg);
        return {
            ux: Math.cos(a),
            uy: Math.sin(a)
        };
    }

    // ---------------------------------------------------------------- helpers

    function isFiniteNumber(v) {
        return (typeof v === 'number') && isFinite(v);
    }

    function numOrDefault(v, def) {
        return isFiniteNumber(v) ? v : def;
    }

    function throwCode(code, message) {
        var e = new Error(message || code);
        e.code = code;
        e.trError = true;
        throw e;
    }

    // -------------------------------------------------- pure angle distributors

    // Distributes `count` items over an angular range.
    //   mode "cyclic"  : END-EXCLUSIVE, angle(i) = start + sweep*(i/count),
    //                    i = 0..count-1 (no duplicate at closure; seamGap ignored).
    //   mode "bounded" : INCLUSIVE, angle(i) = start + sweepEff*(i/(count-1));
    //                    count === 1 -> single item at start + sweepEff/2.
    //                    For sweep >= 360: sweepEff = sweep - seamGapDegrees
    //                    (default 6) so first/last markers do not collide.
    //   sweepEff = sweep otherwise.
    // NOTE: this is the pure index-based distributor; it has no direction and
    // no time knowledge. buildTickPlan maps value-based t onto angles itself.
    function distributeCircular(count, startAngleDeg, sweepDeg, mode, seamGapDegrees) {
        if (!isFiniteNumber(count) || count < 1) {
            throwCode("INVALID_COUNT", "distributeCircular: count must be a number >= 1");
        }
        if (!isFiniteNumber(startAngleDeg) || !isFiniteNumber(sweepDeg)) {
            throwCode("INVALID_ANGLE_INPUT", "distributeCircular: start/sweep must be finite numbers");
        }
        var n = Math.floor(count);
        var items = [];
        var i, t, angle;

        if (mode === "cyclic") {
            for (i = 0; i < n; i++) {
                t = i / n;
                angle = startAngleDeg + sweepDeg * t;
                items[items.length] = { index: i, t: t, angleDeg: angle };
            }
            return items;
        }

        // bounded (default)
        var gap = numOrDefault(seamGapDegrees, DEFAULT_SEAM_GAP);
        var sweepEff = sweepDeg >= (360 - EPS) ? (sweepDeg - gap) : sweepDeg;
        if (sweepEff < EPS && n > 1) {
            throwCode("INVALID_SWEEP", "distributeCircular: effective sweep collapsed to zero");
        }
        if (n === 1) {
            t = 0.5;
            angle = startAngleDeg + sweepEff * 0.5;
            items[items.length] = { index: 0, t: t, angleDeg: angle };
            return items;
        }
        for (i = 0; i < n; i++) {
            t = i / (n - 1);
            angle = startAngleDeg + sweepEff * t;
            items[items.length] = { index: i, t: t, angleDeg: angle };
        }
        return items;
    }

    // Arc distribution = bounded (inclusive) over 1..360 degrees.
    // Pure-inclusive: no seam gap is applied here by design (sweep 360 stays
    // 360 and the two ends coincide — the caller's responsibility).
    function distributeArc(count, startAngleDeg, sweepDeg) {
        if (!isFiniteNumber(sweepDeg) || sweepDeg < 1 || sweepDeg > 360) {
            throwCode("INVALID_SWEEP", "distributeArc: sweep must be within 1..360");
        }
        return distributeCircular(count, startAngleDeg, sweepDeg, "bounded", 0);
    }

    // Inclusive linear distribution. count === 1 -> midpoint of the segment.
    // orientation "horizontal": x varies (y constant), forward: startX..startX+length,
    // reverse: startX..startX-length. orientation "vertical": y varies.
    // dirSign = +1 (forward) / -1 (reverse).
    function distributeLinear(count, startX, startY, length, orientation, direction) {
        if (!isFiniteNumber(count) || count < 1) {
            throwCode("INVALID_COUNT", "distributeLinear: count must be a number >= 1");
        }
        if (!isFiniteNumber(startX) || !isFiniteNumber(startY) || !isFiniteNumber(length)) {
            throwCode("INVALID_LINEAR_INPUT", "distributeLinear: start/length must be finite numbers");
        }
        var n = Math.floor(count);
        var vertical = (orientation === "vertical");
        var dirSign = (direction === "reverse") ? -1 : 1;
        var items = [];
        var i, t, along;

        for (i = 0; i < n; i++) {
            t = (n === 1) ? 0.5 : i / (n - 1);
            along = length * t;
            if (vertical) {
                items[items.length] = {
                    index: i, t: t,
                    x: startX, y: startY + dirSign * along,
                    dirSign: dirSign
                };
            } else {
                items[items.length] = {
                    index: i, t: t,
                    x: startX + dirSign * along, y: startY,
                    dirSign: dirSign
                };
            }
        }
        return items;
    }

    // ------------------------------------------------------- normal/label utils

    // Perpendicular normal for linear rulers (screen coords, y down).
    // tickSide "positive" -> +y for horizontal (below line), +x for vertical (right).
    function linearNormal(orientation, tickSide) {
        var negative = (tickSide === "negative");
        var s = negative ? -1 : 1; // "both" uses the positive normal (symmetric ext)
        if (orientation === "vertical") {
            return { ux: s, uy: 0 };
        }
        return { ux: 0, uy: s };
    }

    function resolveCenter(cfg, compInfo) {
        var geo = cfg.geometry || {};
        var mode = geo.centerMode;
        if (mode === "comp_center") {
            if (compInfo && isFiniteNumber(compInfo.width) && isFiniteNumber(compInfo.height)) {
                return { x: compInfo.width / 2, y: compInfo.height / 2 };
            }
            if (geo.center) {
                return { x: numOrDefault(geo.center.x, 0), y: numOrDefault(geo.center.y, 0) };
            }
            throwCode("MISSING_COMP_INFO", "buildTickPlan: centerMode 'comp_center' needs compInfo {width,height}");
        }
        if (geo.center) {
            return { x: numOrDefault(geo.center.x, 0), y: numOrDefault(geo.center.y, 0) };
        }
        if (compInfo && isFiniteNumber(compInfo.width) && isFiniteNumber(compInfo.height)) {
            return { x: compInfo.width / 2, y: compInfo.height / 2 };
        }
        throwCode("MISSING_CENTER", "buildTickPlan: no center available (set geometry.center or pass compInfo)");
    }

    // ---------------------------------------------------------- sub-division utils

    // Minor t positions for a bounded ruler (ascending t, value-based grid).
    // grid spacing in t = (step/n) / span; skip k multiple of n (major pos);
    // skip t==1 when the end major is included.
    function boundedMinorTs(span, step, n, endIncluded) {
        var ts = [];
        var k, t;
        var spacingT = (step / n) / span;
        var maxK = Math.ceil((1 + EPS) / spacingT) + 1;
        for (k = 1; k <= maxK; k++) {
            t = k * spacingT;
            if (t > 1 + EPS) { break; }
            if (k % n === 0) { continue; } // coincides with a major grid position
            if (endIncluded && Math.abs(t - 1) < EPS) { continue; } // end major spot
            ts[ts.length] = t;
        }
        return ts;
    }

    // Micro t positions for a bounded ruler: grid spacing (step/(n*m))/span;
    // skip k multiple of m (coincides with minor/major grid positions).
    function boundedMicroTs(span, step, n, m, endIncluded) {
        var ts = [];
        var k, t;
        var spacingT = (step / (n * m)) / span;
        var maxK = Math.ceil((1 + EPS) / spacingT) + 1;
        for (k = 1; k <= maxK; k++) {
            t = k * spacingT;
            if (t > 1 + EPS) { break; }
            if (k % m === 0) { continue; } // coincides with minor/major position
            if (endIncluded && Math.abs(t - 1) < EPS) { continue; }
            ts[ts.length] = t;
        }
        return ts;
    }

    // Cyclic: total slots = count*subSlots. skipMod: minors coincide with
    // majors at multiples of n (skipMod = n); micros coincide with minors at
    // multiples of m (skipMod = m, which also covers major slots since m | n*m).
    function cyclicSubTs(count, subSlots, skipMod) {
        var ts = [];
        var total = count * subSlots;
        var k, t;
        for (k = 1; k < total; k++) {
            t = k / total;
            if (k % skipMod === 0) { continue; } // coincides with major/minor position
            ts[ts.length] = t;
        }
        return ts;
    }

    // Sequence-based subdivisions for calendar / timecode (n intervals per major step).
    function sequenceSubTs(values, n, cyclic) {
        var ts = [];
        if (!values || values.length === 0 || n < 2) { return ts; }
        var i, s, t0, t1;
        var limit = cyclic ? values.length : (values.length - 1);
        for (i = 0; i < limit; i++) {
            t0 = values[i].t;
            t1 = (i === values.length - 1 && cyclic) ? 1.0 : values[i + 1].t;
            for (s = 1; s < n; s++) {
                ts[ts.length] = t0 + (t1 - t0) * (s / n);
            }
        }
        return ts;
    }

    // Sequence-based micro subdivisions for calendar / timecode (m per minor interval).
    function sequenceMicroTs(values, n, m, cyclic) {
        var ts = [];
        if (!values || values.length === 0 || n < 2 || m < 2) { return ts; }
        var i, s, sm, t0, t1, tMinor0, tMinor1;
        var limit = cyclic ? values.length : (values.length - 1);
        for (i = 0; i < limit; i++) {
            t0 = values[i].t;
            t1 = (i === values.length - 1 && cyclic) ? 1.0 : values[i + 1].t;
            for (s = 0; s < n; s++) {
                tMinor0 = t0 + (t1 - t0) * (s / n);
                tMinor1 = t0 + (t1 - t0) * ((s + 1) / n);
                for (sm = 1; sm < m; sm++) {
                    ts[ts.length] = tMinor0 + (tMinor1 - tMinor0) * (sm / m);
                }
            }
        }
        return ts;
    }

    // ------------------------------------------------------------ plan builders

    function buildCircularPlan(cfg, compInfo) {
        var geo = cfg.geometry || {};
        var time = cfg.time || {};
        var grad = cfg.graduations || {};
        var typo = cfg.typography || {};
        var teethCfg = cfg.teeth || null;

        var nt = TR.core && TR.core.numericTime ? TR.core.numericTime : null;
        if (!nt) {
            throwCode("NUMERIC_TIME_MISSING", "buildTickPlan: TR.core.numericTime is not loaded");
        }

        var center = resolveCenter(cfg, compInfo);
        var cx = center.x;
        var cy = center.y;
        var radius = numOrDefault(geo.radius,
            (compInfo && isFiniteNumber(compInfo.width) && isFiniteNumber(compInfo.height))
                ? Math.min(compInfo.width, compInfo.height) * 0.35
                : DEFAULT_RADIUS);
        var startAngle = numOrDefault(geo.startAngle, -90);
        var sweep = numOrDefault(geo.sweepAngle, 360);
        var direction = (geo.direction === "counter_clockwise") ? "counter_clockwise" : "clockwise";
        var distributionMode = (geo.distributionMode === "cyclic") ? "cyclic" : "bounded";
        var seamGap = numOrDefault(geo.seamGapDegrees, DEFAULT_SEAM_GAP);
        var counter = (direction === "counter_clockwise");

        // Effective sweep: bounded full-circle keeps a seam gap; cyclic does not.
        var effectiveSweep = sweep;
        if (distributionMode === "bounded" && sweep >= (360 - EPS)) {
            effectiveSweep = sweep - seamGap;
        }
        if (effectiveSweep <= EPS) {
            throwCode("INVALID_SWEEP", "buildTickPlan: effective sweep must be > 0");
        }

        // Time sequence (numeric / calendar / timecode)
        var timeMode = time.mode || "numeric";
        var timeCfg = {};
        var key;
        for (key in time) {
            if (time.hasOwnProperty(key)) { timeCfg[key] = time[key]; }
        }
        timeCfg.distributionMode = distributionMode;

        var seq;
        if (timeMode === "calendar") {
            var cal = TR.core && TR.core.calendarTime ? TR.core.calendarTime : null;
            if (!cal) { throwCode("CALENDAR_TIME_MISSING", "buildTickPlan: TR.core.calendarTime is not loaded"); }
            seq = cal.sequence(timeCfg);
        } else if (timeMode === "timecode") {
            var tc = TR.core && TR.core.timecode ? TR.core.timecode : null;
            if (!tc) { throwCode("TIMECODE_MISSING", "buildTickPlan: TR.core.timecode is not loaded"); }
            seq = tc.sequence(timeCfg, compInfo);
        } else {
            seq = nt.sequence(timeCfg);
        }

        // value-based t -> angle mapping
        function angleForT(t) {
            return counter ? (startAngle - t * effectiveSweep)
                            : (startAngle + t * effectiveSweep);
        }

        function majorItems() {
            var out = [];
            var i, v, t, ang, p, o;
            for (i = 0; i < seq.values.length; i++) {
                v = seq.values[i];
                t = v.t;
                ang = angleForT(t);
                p = pointOnCircle(cx, cy, radius, ang);
                o = outVector(ang);
                out[out.length] = {
                    index: v.index, t: t, angleDeg: ang,
                    x: p.x, y: p.y, ux: o.ux, uy: o.uy
                };
            }
            return out;
        }

        var minorEnabled = !(grad.minor && grad.minor.enabled === false);
        var microEnabled = !(grad.micro && grad.micro.enabled === false);
        var n = Math.floor(numOrDefault(time.minorDivisions, 0));
        var m = Math.floor(numOrDefault(time.microDivisions, 0));
        var minorTs = [];
        var microTs = [];

        if (minorEnabled && n >= 2) {
            if (timeMode === "calendar" || timeMode === "timecode") {
                minorTs = sequenceSubTs(seq.values, n, seq.cyclic);
            } else if (seq.cyclic) {
                minorTs = cyclicSubTs(seq.count, n, n);
            } else {
                minorTs = boundedMinorTs(Math.abs(timeCfg.end - timeCfg.start), numOrDefault(timeCfg.majorStep, 1), n, seq.endIncluded);
            }
        }
        if (minorEnabled && microEnabled && n >= 2 && m >= 2) {
            if (timeMode === "calendar" || timeMode === "timecode") {
                microTs = sequenceMicroTs(seq.values, n, m, seq.cyclic);
            } else if (seq.cyclic) {
                microTs = cyclicSubTs(seq.count, n * m, m);
            } else {
                microTs = boundedMicroTs(Math.abs(timeCfg.end - timeCfg.start), numOrDefault(timeCfg.majorStep, 1), n, m, seq.endIncluded);
            }
        }

        function subItems(ts) {
            var out = [];
            var i, t, ang, p, o;
            for (i = 0; i < ts.length; i++) {
                t = ts[i];
                ang = angleForT(t);
                p = pointOnCircle(cx, cy, radius, ang);
                o = outVector(ang);
                out[out.length] = {
                    index: i, t: t, angleDeg: ang,
                    x: p.x, y: p.y, ux: o.ux, uy: o.uy
                };
            }
            return out;
        }

        var majorItemsList = majorItems();
        var minorItemsList = subItems(minorTs);
        var microItemsList = subItems(microTs);

        // labels
        var labels = [];
        if (!(typo.enabled === false)) {
            var labelRadiusOffset = numOrDefault(typo.radiusOffset, DEFAULT_LABEL_OFFSET);
            var labelRadius = radius + labelRadiusOffset;
            var i, v, t, ang, p, o;
            for (i = 0; i < seq.values.length; i++) {
                v = seq.values[i];
                t = v.t;
                ang = angleForT(t);
                p = pointOnCircle(cx, cy, labelRadius, ang);
                o = outVector(ang);
                var labelText = (timeMode === "calendar" || timeMode === "timecode")
                    ? String(v.label !== undefined && v.label !== null ? v.label : "")
                    : nt.format(v.value, time);
                labels[labels.length] = {
                    index: v.index, t: t, angleDeg: ang,
                    x: p.x, y: p.y, ux: o.ux, uy: o.uy,
                    text: labelText
                };
            }
        }

        var baselineKind = effectiveSweep >= (360 - EPS) ? "circle" : "arc";

        var plan = {
            type: (geo.type === "arc") ? "arc" : "circular",
            cx: cx,
            cy: cy,
            radius: radius,
            startAngle: startAngle,
            sweep: effectiveSweep,
            direction: direction,
            baseline: {
                kind: baselineKind,
                cx: cx, cy: cy, radius: radius,
                startAngle: startAngle,
                sweep: effectiveSweep
            },
            items: {
                major: majorItemsList,
                minor: minorItemsList,
                micro: microItemsList
            },
            labels: labels,
            teeth: null
        };

        // Optional mechanical teeth extension (uniform along the same baseline).
        if (teethCfg && teethCfg.enabled === true) {
            var teethCount = Math.floor(numOrDefault(teethCfg.count, seq.count));
            var tItems = [];
            var ts = [];
            var j;
            if (teethCount === 1) {
                ts = [0.5];
            } else {
                for (j = 0; j < teethCount; j++) { ts[ts.length] = j / (teethCount - 1); }
            }
            for (j = 0; j < ts.length; j++) {
                t = ts[j];
                ang = angleForT(t);
                p = pointOnCircle(cx, cy, radius, ang);
                o = outVector(ang);
                tItems[tItems.length] = {
                    index: j, t: t, angleDeg: ang,
                    x: p.x, y: p.y, ux: o.ux, uy: o.uy
                };
            }
            plan.teeth = tItems;
        }

        return plan;
    }

    function buildLinearPlan(cfg, compInfo) {
        var geo = cfg.geometry || {};
        var time = cfg.time || {};
        var grad = cfg.graduations || {};
        var typo = cfg.typography || {};

        var nt = TR.core && TR.core.numericTime ? TR.core.numericTime : null;
        if (!nt) {
            throwCode("NUMERIC_TIME_MISSING", "buildTickPlan: TR.core.numericTime is not loaded");
        }

        var startX = numOrDefault(geo.startX,
            (compInfo && isFiniteNumber(compInfo.width)) ? compInfo.width * 0.1 : 0);
        var startY = numOrDefault(geo.startY,
            (compInfo && isFiniteNumber(compInfo.height)) ? compInfo.height * 0.5 : 0);
        var length = numOrDefault(geo.length,
            (compInfo && isFiniteNumber(compInfo.width) && isFiniteNumber(compInfo.height))
                ? Math.min(compInfo.width, compInfo.height) * 0.6
                : 400);
        var orientation = (geo.linearOrientation === "vertical") ? "vertical" : "horizontal";
        var linearDirection = (geo.linearDirection === "reverse") ? "reverse" : "forward";
        var tickSide = (geo.tickSide === "negative") ? "negative" : "positive";
        var distributionMode = (geo.distributionMode === "cyclic") ? "cyclic" : "bounded";

        var dirSign = (linearDirection === "reverse") ? -1 : 1;
        var x2 = (orientation === "vertical") ? startX : startX + dirSign * length;
        var y2 = (orientation === "vertical") ? startY + dirSign * length : startY;

        var timeMode = time.mode || "numeric";
        var timeCfg = {};
        var key;
        for (key in time) {
            if (time.hasOwnProperty(key)) { timeCfg[key] = time[key]; }
        }
        timeCfg.distributionMode = distributionMode;

        var seq;
        if (timeMode === "calendar") {
            var cal = TR.core && TR.core.calendarTime ? TR.core.calendarTime : null;
            if (!cal) { throwCode("CALENDAR_TIME_MISSING", "buildTickPlan: TR.core.calendarTime is not loaded"); }
            seq = cal.sequence(timeCfg);
        } else if (timeMode === "timecode") {
            var tc = TR.core && TR.core.timecode ? TR.core.timecode : null;
            if (!tc) { throwCode("TIMECODE_MISSING", "buildTickPlan: TR.core.timecode is not loaded"); }
            seq = tc.sequence(timeCfg, compInfo);
        } else {
            seq = nt.sequence(timeCfg);
        }

        function posForT(t) {
            var along = length * t;
            if (orientation === "vertical") {
                return { x: startX, y: startY + dirSign * along };
            }
            return { x: startX + dirSign * along, y: startY };
        }

        function listFromSeq(values) {
            var out = [];
            var i, v, p, nrm;
            for (i = 0; i < values.length; i++) {
                v = values[i];
                p = posForT(v.t);
                nrm = linearNormal(orientation, tickSide);
                out[out.length] = {
                    index: v.index, t: v.t,
                    x: p.x, y: p.y, ux: nrm.ux, uy: nrm.uy
                };
            }
            return out;
        }

        var minorEnabled = !(grad.minor && grad.minor.enabled === false);
        var microEnabled = !(grad.micro && grad.micro.enabled === false);
        var n = Math.floor(numOrDefault(time.minorDivisions, 0));
        var m = Math.floor(numOrDefault(time.microDivisions, 0));
        var minorTs = [];
        var microTs = [];

        if (minorEnabled && n >= 2) {
            if (timeMode === "calendar" || timeMode === "timecode") {
                minorTs = sequenceSubTs(seq.values, n, seq.cyclic);
            } else if (seq.cyclic) {
                minorTs = cyclicSubTs(seq.count, n, n);
            } else {
                minorTs = boundedMinorTs(Math.abs(timeCfg.end - timeCfg.start), numOrDefault(timeCfg.majorStep, 1), n, seq.endIncluded);
            }
        }
        if (minorEnabled && microEnabled && n >= 2 && m >= 2) {
            if (timeMode === "calendar" || timeMode === "timecode") {
                microTs = sequenceMicroTs(seq.values, n, m, seq.cyclic);
            } else if (seq.cyclic) {
                microTs = cyclicSubTs(seq.count, n * m, m);
            } else {
                microTs = boundedMicroTs(Math.abs(timeCfg.end - timeCfg.start), numOrDefault(timeCfg.majorStep, 1), n, m, seq.endIncluded);
            }
        }

        function subList(ts) {
            var out = [];
            var i, p, nrm;
            for (i = 0; i < ts.length; i++) {
                p = posForT(ts[i]);
                nrm = linearNormal(orientation, tickSide);
                out[out.length] = {
                    index: i, t: ts[i],
                    x: p.x, y: p.y, ux: nrm.ux, uy: nrm.uy
                };
            }
            return out;
        }

        var labels = [];
        if (!(typo.enabled === false)) {
            var labelOffset = numOrDefault(geo.labelOffset, DEFAULT_LABEL_OFFSET);
            var nrm = linearNormal(orientation, tickSide);
            var i, v, p;
            for (i = 0; i < seq.values.length; i++) {
                v = seq.values[i];
                p = posForT(v.t);
                var labelText = (timeMode === "calendar" || timeMode === "timecode")
                    ? String(v.label !== undefined && v.label !== null ? v.label : "")
                    : nt.format(v.value, time);
                labels[labels.length] = {
                    index: v.index, t: v.t,
                    x: p.x + nrm.ux * labelOffset,
                    y: p.y + nrm.uy * labelOffset,
                    ux: nrm.ux, uy: nrm.uy,
                    text: labelText
                };
            }
        }

        var plan = {
            type: "linear",
            baseline: {
                kind: "line",
                x1: startX, y1: startY, x2: x2, y2: y2
            },
            items: {
                major: listFromSeq(seq.values),
                minor: subList(minorTs),
                micro: subList(microTs)
            },
            labels: labels,
            teeth: null
        };

        if (cfg.teeth && cfg.teeth.enabled === true) {
            var teethCount = Math.floor(numOrDefault(cfg.teeth.count, seq.count));
            var ts2 = [];
            var j;
            if (teethCount === 1) { ts2 = [0.5]; }
            else {
                for (j = 0; j < teethCount; j++) { ts2[ts2.length] = j / (teethCount - 1); }
            }
            var tItems = [];
            for (j = 0; j < ts2.length; j++) {
                p = posForT(ts2[j]);
                tItems[tItems.length] = {
                    index: j, t: ts2[j],
                    x: p.x, y: p.y,
                    ux: (orientation === "vertical") ? 1 : 0,
                    uy: (orientation === "vertical") ? 0 : 1
                };
            }
            plan.teeth = tItems;
        }

        return plan;
    }

    // ------------------------------------------------------------ master entry

    // Master entry producing a LayoutPlan consumed by the AE adapter lane.
    // cfg schema "1.0":
    //   geometry { type, centerMode, center{x,y}, radius, startAngle, sweepAngle,
    //              direction, distributionMode, seamGapDegrees, linearOrientation,
    //              startX, startY, length, linearDirection, tickSide, labelOffset }
    //   time     { mode, start, end, majorStep, minorDivisions, microDivisions,
    //              includeEndPoint, precision, prefix, suffix }
    //   graduations { major/minor/micro: {enabled, length, width, offset, color, opacity} }
    //   typography  { enabled, radiusOffset, orientation, ... }
    //   teeth (optional) { enabled, count } -> plan.teeth items, else plan.teeth === null
    // compInfo { width, height } optional (needed for centerMode "comp_center").
    //
    // NOTE: no density capping here — oversized configs compute fully; caps are
    // the validation lane's job (spec 11.1).
    function buildTickPlan(cfg, compInfo) {
        if (!cfg || !cfg.geometry) {
            throwCode("MISSING_GEOMETRY", "buildTickPlan: cfg.geometry is required");
        }
        if (!cfg.time) {
            throwCode("MISSING_TIME", "buildTickPlan: cfg.time is required");
        }
        var geoType = cfg.geometry.type;
        if (geoType === "linear") {
            return buildLinearPlan(cfg, compInfo);
        }
        if (geoType === "circular" || geoType === "arc" || !geoType) {
            return buildCircularPlan(cfg, compInfo);
        }
        throwCode("UNKNOWN_GEOMETRY_TYPE", "buildTickPlan: unknown geometry.type '" + String(geoType) + "'");
    }

    var api = {
        degToRad: degToRad,
        pointOnCircle: pointOnCircle,
        outVector: outVector,
        distributeCircular: distributeCircular,
        distributeArc: distributeArc,
        distributeLinear: distributeLinear,
        buildTickPlan: buildTickPlan
    };

    return api;
})();
