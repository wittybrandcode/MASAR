// ============================================================================
// TIME RULER — AE Composition Access (ExtendScript ES3)
// ============================================================================
// Module: TR.ae.composition
// Environment: After Effects 2023+ (ExtendScript ES3). Touches the AE DOM and
// is therefore ONLY allowed inside host/ae/* modules and api.jsxinc.
//
// Role: the single guarded entry point to the ACTIVE composition. The API
// layer (api.jsxinc) delegates every "which comp are we on?" question here so
// the NO_PROJECT / NO_ACTIVE_COMP error contract lives in exactly one place.
//
// Exposed:
//   getActiveComp()               -> CompItem, or throws coded error
//                                    NO_PROJECT / NO_ACTIVE_COMP
//   compInfoOf(comp)              -> plain info object (all reads guarded)
//   getActiveCompInfo()           -> getActiveComp() + compInfoOf()
//
// ES3 rules: var only, classic loops, try/catch/finally, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.ae = TR.ae || {};
TR.ae.composition = (function () {

    function err(code, message) {
        var e = new Error(message || code);
        e.code = code;
        e.trError = true;
        return e;
    }

    function numOrNull(v) {
        return (typeof v === 'number' && isFinite(v)) ? v : 0;
    }

    function isComp(item) {
        if (!item || typeof item !== 'object') { return false; }
        try {
            if (typeof CompItem !== 'undefined' && item instanceof CompItem) {
                return true;
            }
        } catch (e1) { /* guarded */ }
        try {
            if (item.layers && typeof item.numLayers === 'number') {
                return true;
            }
        } catch (e2) { /* guarded */ }
        try {
            if (item.typeName && (/Comp/i.test(item.typeName) || /Komposition/i.test(item.typeName))) {
                return true;
            }
        } catch (e3) { /* guarded */ }
        return false;
    }

    // ------------------------------------------------------------- getActiveComp

    /**
     * Returns the active CompItem or throws {code:"NO_PROJECT"} /
     * {code:"NO_ACTIVE_COMP"}. Multi-tier resolution:
     * 1. app.project.activeItem (direct active item)
     * 2. app.activeViewer (brings comp viewer to front if CEP panel had focus)
     * 3. app.project.selection (single CompItem selected in project panel)
     * 4. app.project.items (if exactly 1 comp exists in project)
     */
    function getActiveComp() {
        if (typeof app === 'undefined' || app === null) {
            throw err('HOST_UNAVAILABLE', 'After Effects host is not available (no `app` global).');
        }
        var proj = null;
        try { proj = app.project; } catch (eP) { proj = null; }
        if (proj === null) {
            throw err('NO_PROJECT', 'No project is open in After Effects.');
        }

        var comp = null;

        // 1. Direct check of app.project.activeItem
        try {
            var item = proj.activeItem;
            if (isComp(item)) {
                comp = item;
                TR._lastActiveComp = comp;
                return comp;
            }
        } catch (eA) { comp = null; }

        // 2. Active viewer check (preserves active comp when CEP panel has focus)
        // Reading app.activeViewer.activeComp is non-intrusive and does NOT steal OS focus
        try {
            if (typeof app.activeViewer !== 'undefined' && app.activeViewer !== null) {
                var isCompViewer = false;
                try {
                    if (typeof ViewerType !== 'undefined') {
                        isCompViewer = (app.activeViewer.type === ViewerType.VIEWER_COMPOSITION);
                    } else if (app.activeViewer.type === 1 || app.activeViewer.type === 'composition' || app.activeViewer.type === 'Composition') {
                        isCompViewer = true;
                    }
                } catch (eType) { isCompViewer = false; }

                if (isCompViewer && app.activeViewer.activeComp && isComp(app.activeViewer.activeComp)) {
                    comp = app.activeViewer.activeComp;
                    TR._lastActiveComp = comp;
                    return comp;
                }
            }
        } catch (eVw) { /* guarded */ }

        // 3. Check selected items in project panel (single CompItem selected)
        if (comp === null) {
            try {
                var sel = proj.selection;
                if (sel && sel.length === 1 && isComp(sel[0])) {
                    comp = sel[0];
                    TR._lastActiveComp = comp;
                    return comp;
                }
            } catch (eS) { /* guarded */ }
        }

        // 4. Fallback: only if EXACTLY 1 composition exists in the entire project
        if (comp === null) {
            try {
                var total = (typeof proj.numItems === 'number') ? proj.numItems : 0;
                var foundComps = [];
                for (var idx = 1; idx <= total; idx++) {
                    var pItem = null;
                    try { pItem = proj.item(idx); } catch (eIt) { pItem = null; }
                    if (isComp(pItem)) {
                        foundComps.push(pItem);
                    }
                }
                if (foundComps.length === 1) {
                    comp = foundComps[0];
                    TR._lastActiveComp = comp;
                    return comp;
                }
            } catch (eItems) { /* guarded */ }
        }

        if (comp === null) {
            TR._lastActiveComp = null;
            throw err('NO_ACTIVE_COMP', 'No active composition. Open a comp first.');
        }
        return comp;
    }

    // ---------------------------------------------------------------- compInfoOf

    /**
     * Plain serializable info snapshot of a CompItem. Each field read is
     * individually guarded (AE throws on some items mid-project-load).
     */
    function compInfoOf(comp) {
        var info = {
            name: '',
            compName: '',
            width: 0,
            height: 0,
            duration: 0,
            frameRate: 0,
            pixelAspect: 1,
            workAreaStart: 0,
            workAreaDuration: 0,
            selectionCount: 0
        };
        if (comp === null || typeof comp !== 'object') { return info; }
        try {
            info.name = String(comp.name);
            info.compName = info.name;
        } catch (eN) { /* guarded */ }
        try { info.width = numOrNull(comp.width); } catch (eW) { /* guarded */ }
        try { info.height = numOrNull(comp.height); } catch (eH) { /* guarded */ }
        try { info.duration = numOrNull(comp.duration); } catch (eD) { /* guarded */ }
        try { info.frameRate = numOrNull(comp.frameRate); } catch (eF) { /* guarded */ }
        try { info.pixelAspect = numOrNull(comp.pixelAspect); } catch (ePa) { /* guarded */ }
        if (info.pixelAspect <= 0) { info.pixelAspect = 1; }
        try { info.workAreaStart = numOrNull(comp.workAreaStart); } catch (eWs) { /* guarded */ }
        try { info.workAreaDuration = numOrNull(comp.workAreaDuration); } catch (eWd) { /* guarded */ }
        try {
            info.selectionCount = comp.selectedLayers.length;
        } catch (eS) { info.selectionCount = 0; }
        return info;
    }

    // --------------------------------------------------------- getActiveCompInfo

    /**
     * Convenience: comp resolution + info snapshot in one call.
     * (Moved here from api.jsxinc in Milestone 3; the API method delegates.)
     */
    function getActiveCompInfo() {
        var comp = getActiveComp();
        var info = compInfoOf(comp);
        info.comp = comp; /* non-serialized comp ref for the generation path */
        return info;
    }

    var api = {
        getActiveComp: getActiveComp,
        compInfoOf: compInfoOf,
        getActiveCompInfo: getActiveCompInfo
    };

    return api;
})();
