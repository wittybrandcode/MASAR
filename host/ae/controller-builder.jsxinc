// ============================================================================
// TIME RULER — AE Master Controller Builder (ExtendScript ES3)
// ============================================================================
// Module: TR.ae.controllerBuilder
// Environment: After Effects 2023+ (ExtendScript ES3). AE DOM access stays in
// host/ae/* modules.
//
// createMaster(comp, name, center) -> layer|null
//
//   Adds the master controller NULL ("TR_<ID>_CTRL_MAIN"):
//     - comp.layers.addNull() (default 100x100 null source; sizing is NOT
//       forced here — see open question in tests/manual-test-matrix.md M3).
//     - anchorPoint [0,0], position = [centerX, centerY] (world coords; the
//       null is the parent-pivot for the whole instance).
//   Metadata (comment) is written by the generation path, not here, so this
//   module stays a single-purpose constructor.
//
// RIG-MODE EFFECT HELPERS (Milestone 5, spec 9.1) — added to the layer's
// "ADBE Effect Parade":
//
//   createSlider(layer, name, defaultValue)      -> effect|null
//       "ADBE Slider Control", inner "ADBE Slider Control-0001".
//       The 0..100 range is a CONFIG-side contract (validation lane); AE
//       sliders are not range-limited via scripting, the helper only seeds
//       the default value.
//   createColorControl(layer, name, defaultHex)  -> effect|null
//       "ADBE Color Control", inner "ADBE Color Control-0001", value
//       [r,g,b,1] parsed from "#RRGGBB" (local parser kept in sync with
//       shape-builder.hexToRgb — a broken color stays VISIBLE magenta).
//   createAngle(layer, name, defaultValue)       -> effect|null
//       "ADBE Angle Control", inner "ADBE Angle Control-0001" (degrees).
//
//   Each helper renames the effect via the .name setter (the display name is
//   what expressions address: effect("Progress")("Slider")). The VALUE is
//   written on the freshly returned addProperty reference BEFORE the rename
//   (matchName lookup is unaffected by display names; the M3 invalidation
//   rule means the parade reference is re-fetched per helper call, never
//   cached across addProperty calls). A failed rename returns null — the
//   expression binds address effects BY NAME, so an unnamed effect would
//   silently break the rig.
//
// ES3 rules: var only, classic loops, try/catch/finally, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.ae = TR.ae || {};
TR.ae.controllerBuilder = (function () {

    function prop(parent, matchName) {
        if (parent === null || typeof parent !== 'object') { return null; }
        try {
            var p = parent.property(matchName);
            return (p === null || typeof p === 'undefined') ? null : p;
        } catch (eP) { return null; }
    }

    function setSafe(p, v) {
        if (p === null || typeof p !== 'object') { return false; }
        try { p.setValue(v); return true; } catch (eS) { return false; }
    }

    function createMaster(comp, name, center) {
        try {
            var layer = comp.layers.addNull();
            if (layer === null || typeof layer !== 'object') { return null; }
            try { layer.name = name; } catch (eNm) { /* default name acceptable */ }
            var t = prop(layer, 'ADBE Transform Group');
            var ap = (t !== null) ? prop(t, 'ADBE Anchor Point') : null;
            var pp = (t !== null) ? prop(t, 'ADBE Position') : null;
            if (ap === null && typeof layer.anchorPoint !== 'undefined') { ap = layer.anchorPoint; }
            if (pp === null && typeof layer.position !== 'undefined') { pp = layer.position; }
            setSafe(ap, [0, 0, 0]);
            setSafe(pp, [center[0], center[1], 0]);
            return layer;
        } catch (eL) {
            if (TR.log) { TR.log('ERROR', 'createMaster failed: ' + String(eL && eL.message ? eL.message : eL)); }
            return null;
        }
    }

    // ------------------------------------------------------------------ rig
    // M5 effect helpers (see header). Kept here so the controller owns BOTH
    // halves of the rig surface: the null itself and the effect controls.

    var FX_PARADE = 'ADBE Effect Parade';
    var FX_SLIDER = 'ADBE Slider Control';
    var FX_SLIDER_VAL = 'ADBE Slider Control-0001';
    var FX_COLOR = 'ADBE Color Control';
    var FX_COLOR_VAL = 'ADBE Color Control-0001';
    var FX_ANGLE = 'ADBE Angle Control';
    var FX_ANGLE_VAL = 'ADBE Angle Control-0001';

    /**
     * "#RRGGBB" -> [r,g,b] floats 0..1; malformed -> magenta. Local copy kept
     * in sync with shape-builder.hexToRgb (this module stays self-contained).
     */
    function hexToRgb(hex) {
        var m = (typeof hex === 'string') ? hex.match(/^#([0-9A-Fa-f]{6})$/) : null;
        if (m === null) { return [1, 0, 1]; }
        var intVal = parseInt(m[1], 16);
        if (isNaN(intVal)) { return [1, 0, 1]; }
        return [
            ((intVal >> 16) & 255) / 255,
            ((intVal >> 8) & 255) / 255,
            (intVal & 255) / 255
        ];
    }

    /** The layer's effects group; created lazily when absent. */
    function ensureParade(layer) {
        if (layer === null || typeof layer !== 'object') { return null; }
        var parade = prop(layer, FX_PARADE);
        if (parade !== null) { return parade; }
        try { return layer.addProperty(FX_PARADE); } catch (eP) { return null; }
    }

    /**
     * Adds one named effect with a seeded default value on its single
     * parameter. Returns the effect, or null when creation or the DISPLAY
     * NAME rename failed (nameless effects would break the named binds).
     */
    function addEffect(layer, matchName, valueMatchName, displayName, defaultValue) {
        var parade = ensureParade(layer);
        if (parade === null) { return null; }
        var fx = null;
        try { fx = parade.addProperty(matchName); } catch (eA) { fx = null; }
        if (fx === null) { return null; }
        if (defaultValue !== null) {
            var vProp = prop(fx, valueMatchName);
            if (vProp === null) {
                try { vProp = fx.property(1); } catch (eP1) { vProp = null; }
            }
            setSafe(vProp, defaultValue);
        }
        try { fx.name = displayName; } catch (eNm) {
            if (TR.log) {
                TR.log('ERROR', 'effect rename failed: ' + String(eNm && eNm.message ? eNm.message : eNm));
            }
            return null;
        }
        return fx;
    }

    /** Slider control seeded with defaultValue (0..100 is a config contract). */
    function createSlider(layer, name, defaultValue) {
        var v = (typeof defaultValue === 'number' && isFinite(defaultValue)) ? defaultValue : 0;
        return addEffect(layer, FX_SLIDER, FX_SLIDER_VAL, String(name), v);
    }

    /** Color control seeded from "#RRGGBB" -> [r,g,b,1]. */
    function createColorControl(layer, name, defaultHex) {
        var rgb = hexToRgb(defaultHex);
        return addEffect(layer, FX_COLOR, FX_COLOR_VAL, String(name), [rgb[0], rgb[1], rgb[2], 1]);
    }

    /** Angle control seeded with defaultValue (degrees). */
    function createAngle(layer, name, defaultValue) {
        var v = (typeof defaultValue === 'number' && isFinite(defaultValue)) ? defaultValue : 0;
        return addEffect(layer, FX_ANGLE, FX_ANGLE_VAL, String(name), v);
    }

    var api = {
        createMaster: createMaster,
        createSlider: createSlider,
        createColorControl: createColorControl,
        createAngle: createAngle
    };

    return api;
})();
