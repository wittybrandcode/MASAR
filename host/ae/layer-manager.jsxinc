// ============================================================================
// TIME RULER — AE Layer Manager (ExtendScript ES3)
// ============================================================================
// Module: TR.ae.layerManager
// Environment: After Effects 2023+ (ExtendScript ES3). AE DOM access stays in
// host/ae/* modules.
//
// Small lifecycle utilities shared by the generation path (api.jsxinc):
//
//   positionAtT(plan, t)      -> {x, y} world point at fraction t of the
//                                baseline (0..1). Marker/progress mapping.
//                                - circular/arc: angle = startAngle +
//                                  dirSign*sweep*t (dirSign +1 clockwise /
//                                  -1 counter_clockwise, per plan.direction),
//                                  point on the baseline circle.
//                                - linear: lerp along baseline x1y1..x2y2.
//   applyParent(layers, ctrl) -> sets .parent on every created layer except
//                                the controller itself. Called AFTER all
//                                layers are positioned: AE's .parent setter
//                                counterbalances child transforms, so world
//                                positions are preserved (no jump).
//   safeRemove(layer)         -> guarded layer.remove(); own layers only
//                                (callers must pass layers they created).
//
// ES3 rules: var only, classic loops, try/catch/finally, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.ae = TR.ae || {};
TR.ae.layerManager = (function () {

    // ------------------------------------------------------------- positionAtT

    function positionAtT(plan, t) {
        var tt = (typeof t === 'number' && isFinite(t)) ? t : 0;
        if (tt < 0) { tt = 0; }
        if (tt > 1) { tt = 1; }

        if (plan && plan.type === 'linear') {
            var b = plan.baseline;
            return {
                x: b.x1 + (b.x2 - b.x1) * tt,
                y: b.y1 + (b.y2 - b.y1) * tt
            };
        }

        /* circular / arc */
        var dirSign = (plan && plan.direction === 'counter_clockwise') ? -1 : 1;
        var angle = plan.startAngle + dirSign * plan.sweep * tt;
        var geo = (TR.core && TR.core.geometry) ? TR.core.geometry : null;
        if (geo !== null) {
            var p = geo.pointOnCircle(plan.cx, plan.cy, plan.radius, angle);
            return { x: p.x, y: p.y };
        }
        /* geometry engine missing: last-resort inline math (same contract). */
        var a = angle * Math.PI / 180;
        return {
            x: plan.cx + plan.radius * Math.cos(a),
            y: plan.cy + plan.radius * Math.sin(a)
        };
    }

    // ------------------------------------------------------------- applyParent

    /**
     * Parent every layer in `layers` to ctrlLayer (except the controller
     * itself). AE counterbalances transforms on assignment, so previously set
     * world positions are preserved. Per-layer guarded: one bad layer never
     * breaks the batch.
     */
    function applyParent(layers, ctrlLayer) {
        if (!ctrlLayer || typeof ctrlLayer !== 'object') { return false; }
        var ok = true;
        for (var i = 0; i < layers.length; i++) {
            var layer = layers[i];
            if (layer === null || typeof layer !== 'object') { continue; }
            if (layer === ctrlLayer) { continue; }
            try {
                layer.parent = ctrlLayer;
            } catch (eP) {
                ok = false;
                if (TR.log) {
                    TR.log('ERROR', 'applyParent failed for a created layer: ' +
                        String(eP && eP.message ? eP.message : eP));
                }
            }
        }
        return ok;
    }

    // ---------------------------------------------------------------- safeRemove

    /**
     * Guarded removal of a layer THIS TOOL CREATED (hard rule: never touch
     * user layers). Used by the failure-cleanup path and later milestones.
     */
    function safeRemove(layer) {
        if (layer === null || typeof layer !== 'object') { return false; }
        try {
            layer.remove();
            return true;
        } catch (eR) {
            if (TR.log) {
                TR.log('ERROR', 'safeRemove failed: ' + String(eR && eR.message ? eR.message : eR));
            }
            return false;
        }
    }

    var api = {
        positionAtT: positionAtT,
        applyParent: applyParent,
        safeRemove: safeRemove
    };

    return api;
})();
