// ============================================================================
// TIME RULER — AE Shape Builder (low-level primitives) (ExtendScript ES3)
// ============================================================================
// Module: TR.ae.shapeBuilder
// Environment: After Effects 2023+ (ExtendScript ES3). AE DOM access stays in
// host/ae/* modules; core/client files never call this module.
//
// LOW-LEVEL PRIMITIVES (no layout knowledge — the generation path in
// api.jsxinc owns LayoutPlan -> geometry decisions):
//
//   hexToRgb(hex)                  -> [r,g,b] floats 0..1
//   newShapeLayer(comp, name, pos) -> shape layer at pos, anchor [0,0]
//   addVectorGroup(contents, name) -> "ADBE Vector Group" child, renamed
//   setPath(group, shapeObj)       -> "ADBE Vector Shape - Group" ->
//                                     inner "ADBE Vector Shape" setValue
//   addStroke(group, color, width, opacity, caps)
//   addFill(group, color, opacity)
//   disableFill(group)
//   linePath(p0, p1)               -> open 2-point Shape
//   polylinePath(points, closed)   -> Shape (straight segments, zero tangents)
//   ellipsePath(size, pos)         -> 4-vertex Bezier circle/ellipse Shape
//   rectPath(w, h, pos)            -> closed 4-point Shape
//   polyPath(points)               -> closed straight Shape
//   setEllipse(group, size, pos)   -> "ADBE Vector Shape - Ellipse" path with
//                                     "ADBE Vector Ellipse Size"/"Position"
//   setLayerTransform(layer, pos)  -> anchorPoint [0,0,0], position pos
//   setLayerRotation(layer, deg)
//
// MATCHNAME POLICY (hard rule): property access uses matchNames ONLY
// (locale-proof). Well-known values used here — all from the AE scripting
// guide's property match-name tables:
//   Contents root        "ADBE Root Vectors Group"
//   vector group         "ADBE Vector Group"
//   bezier path group    "ADBE Vector Shape - Group"  (inner prop
//                        "ADBE Vector Shape", value type SHAPE)
//   ellipse              "ADBE Vector Shape - Ellipse"
//                        "ADBE Vector Ellipse Size" / "ADBE Vector Ellipse
//                        Position"
//   rect                 "ADBE Vector Shape - Rect"
//   stroke               "ADBE Vector Graphic - Stroke" ("ADBE Vector Stroke
//                        Color/Width/Opacity", "ADBE Vector Stroke Line Cap",
//                        "ADBE Vector Stroke Line Join")
//   fill                 "ADBE Vector Graphic - Fill" ("ADBE Vector Fill
//                        Color", "ADBE Vector Fill Opacity")
//   transform            "ADBE Transform Group" ("ADBE Anchor Point",
//                        "ADBE Position")
//
// INVALIDATION RULE (hard rule): addProperty() on indexed groups invalidates
// previously held references. Every helper therefore (re)fetches its child
// references immediately before use and never caches across addProperty calls.
//
// LAYER COORDINATE SYSTEM (generation convention, see api.jsxinc):
//   Each created layer gets anchorPoint = [0,0] and position = the layer's
//   "local origin" in world coords (comp center for circular/arc layers,
//   baseline midpoint for linear layers). ALL path/shape coordinates are LOCAL
//   = world - origin. Labels are the exception: the text layer's position IS
//   the label point, because centering uses sourceRectAtTime.
//
// TICK ALIGNMENT SEMANTICS (v1, consumed by api.jsxinc):
//   A tick anchor {x,y} from the LayoutPlan sits ON the baseline; {ux,uy} is
//   the unit vector pointing OUTWARD from the ruler. graduations.<level>:
//   - `length` extends the tick OUTWARD from the baseline anchor along u.
//   - `offset` shifts the tick's START POINT along u first (positive offset
//     lifts the whole tick off the baseline; negative pushes it inward).
//   Segment = anchor + u*offset  ->  anchor + u*(offset + length).
//   The engine never shortens ticks for overlaps — density is the
//   validation lane's contract.
//
// STROKE CAPS / JOINS: "ADBE Vector Stroke Line Cap": 1 = butt, 2 = round,
// 3 = projecting. "ADBE Vector Stroke Line Join": 1 = miter, 2 = round,
// 3 = bevel. Tick/teeth work passes explicit values (butt/miter default,
// round for the progress preview).
//
// ES3 rules: var only, classic loops, try/catch/finally, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.ae = TR.ae || {};
TR.ae.shapeBuilder = (function () {

    var MN = {
        rootVectors: 'ADBE Root Vectors Group',
        group: 'ADBE Vector Group',
        shapeGroup: 'ADBE Vector Shape - Group',
        shape: 'ADBE Vector Shape',
        ellipse: 'ADBE Vector Shape - Ellipse',
        ellipseSize: 'ADBE Vector Ellipse Size',
        ellipsePosition: 'ADBE Vector Ellipse Position',
        rect: 'ADBE Vector Shape - Rect',
        rectSize: 'ADBE Vector Rect Size',
        rectPosition: 'ADBE Vector Rect Position',
        stroke: 'ADBE Vector Graphic - Stroke',
        strokeColor: 'ADBE Vector Stroke Color',
        strokeWidth: 'ADBE Vector Stroke Width',
        strokeOpacity: 'ADBE Vector Stroke Opacity',
        strokeLineCap: 'ADBE Vector Stroke Line Cap',
        strokeLineJoin: 'ADBE Vector Stroke Line Join',
        fill: 'ADBE Vector Graphic - Fill',
        fillColor: 'ADBE Vector Fill Color',
        fillOpacity: 'ADBE Vector Fill Opacity',
        transform: 'ADBE Transform Group',
        anchorPoint: 'ADBE Anchor Point',
        position: 'ADBE Position'
    };

    var CAP_BUTT = 1, CAP_ROUND = 2;
    var JOIN_MITER = 1, JOIN_ROUND = 2;

    // ---------------------------------------------------------------- colors

    /**
     * "#RRGGBB" -> [r,g,b] floats 0..1. Malformed input -> magenta so a broken
     * color is VISIBLE rather than silently black.
     */
    function hexToRgb(hex) {
        var m = (typeof hex === 'string') ? hex.match(/^#([0-9A-Fa-f]{6})$/) : null;
        if (m === null) { return [1, 0, 1]; }
        var intVal = parseInt(m[1], 16);
        if (isNaN(intVal)) { return [1, 0, 1]; }
        return [
            ((intVal >> 16) & 255) / 255,
            ((intVal >> 8) & 255) / 255,
            (intVal & 255) / 255
        ];
    }

    // ------------------------------------------------------------ ref helpers

    /**
     * Fresh property lookup by matchName; returns null when absent. NOTE the
     * AE invalidation rule: call this AFTER any addProperty() — never reuse a
     * reference captured before one.
     */
    function prop(parent, matchName) {
        if (parent === null || typeof parent !== 'object') { return null; }
        try {
            var p = parent.property(matchName);
            return (p === null || typeof p === 'undefined') ? null : p;
        } catch (eP) {
            return null;
        }
    }

    /**
     * property-or-create. Returns the child for matchName, adding it when the
     * group does not carry that property yet (tolerates AE versions that
     * create Vector Groups with/without default Stroke and Fill).
     */
    function ensureProp(parent, matchName) {
        var existing = prop(parent, matchName);
        if (existing !== null) { return existing; }
        try {
            return parent.addProperty(matchName);
        } catch (eA) {
            return null;
        }
    }

    function setSafe(property, value) {
        if (property === null || typeof property !== 'object') { return false; }
        try { property.setValue(value); return true; } catch (eS) { return false; }
    }

    // ----------------------------------------------------------------- layers

    /**
     * New shape layer named `name`, positioned at pos ([x,y] or [x,y,z]),
     * anchor point locked to [0,0] so path coordinates stay local.
     * Returns the layer, or null when creation failed.
     */
    function newShapeLayer(comp, name, pos) {
        try {
            var layer = comp.layers.addShape();
            try { layer.name = name; } catch (eNm) { /* keep AE default name */ }
            setLayerTransform(layer, pos);
            return layer;
        } catch (eL) {
            if (TR.log) { TR.log('ERROR', 'newShapeLayer failed: ' + String(eL && eL.message ? eL.message : eL)); }
            return null;
        }
    }

    /**
     * anchorPoint [0,0] + position pos on a layer's transform group. Re-fetched
     * references (matchNames) — fresh lookup right before each setValue.
     */
    function setLayerTransform(layer, pos) {
        if (layer === null || typeof layer !== 'object') { return false; }
        var t = prop(layer, MN.transform);
        if (t === null) { t = layer; /* fallback: shortcuts exist on the layer */ }
        var ap = prop(t, MN.anchorPoint);
        if (ap === null && typeof layer.anchorPoint !== 'undefined') { ap = layer.anchorPoint; }
        var pp = prop(t, MN.position);
        if (pp === null && typeof layer.position !== 'undefined') { pp = layer.position; }
        var ok = true;
        if (ap !== null) { ok = setSafe(ap, [0, 0, 0]) && ok; }
        if (pp !== null) { ok = setSafe(pp, [pos[0], pos[1], 0]) && ok; }
        return ok;
    }

    function setLayerRotation(layer, deg) {
        if (layer === null || typeof layer !== 'object') { return false; }
        var t = prop(layer, MN.transform);
        var r = (t !== null) ? prop(t, 'ADBE Rotate Z') : null;
        if (r === null) { r = (typeof layer.rotation !== 'undefined') ? layer.rotation : null; }
        if (r !== null) { return setSafe(r, deg); }
        return false;
    }

    // ----------------------------------------------------------- vector groups

    /**
     * Adds a vector group ("ADBE Vector Group") to Contents and renames it.
     * The rename must happen on the freshly returned reference (the old one is
     * invalidated by addProperty).
     */
    function addVectorGroup(contents, name) {
        if (contents === null || typeof contents !== 'object') { return null; }
        var g = null;
        try {
            g = contents.addProperty(MN.group);
        } catch (eA) {
            return null;
        }
        if (g === null) { return null; }
        try { g.name = name; } catch (eNm) { /* AE default name acceptable */ }
        return g;
    }

    function contentsOf(layer) {
        if (layer === null || typeof layer !== 'object') { return null; }
        return prop(layer, MN.rootVectors);
    }

    // ------------------------------------------------------------------ paths

    /**
     * Sets the group's Bezier path (inner "ADBE Vector Shape") from a Shape
     * object built by the path helpers below.
     */
    function setPath(group, shapeObj) {
        if (group === null || typeof group !== 'object' || shapeObj === null) { return false; }
        var pathGroup = ensureProp(group, MN.shapeGroup);
        if (pathGroup === null) { return false; }
        var pathProp = prop(pathGroup, MN.shape);
        if (pathProp === null) { return false; }
        return setSafe(pathProp, shapeObj);
    }

    function setEllipse(group, size, pos) {
        if (group === null || typeof group !== 'object') { return false; }
        var ellipse = ensureProp(group, MN.ellipse);
        if (ellipse === null) { return false; }
        var ok = true;
        ok = setSafe(ensureProp(ellipse, MN.ellipseSize), [size[0], size[1]]) && ok;
        ok = setSafe(ensureProp(ellipse, MN.ellipsePosition), [pos[0], pos[1]]) && ok;
        return ok;
    }

    // ------------------------------------------------------------- paint ops

    /**
     * Stroke on a group. Reuses the default stroke when the group carries one
     * (fresh lookup AFTER any addProperty elsewhere). caps/joins optional.
     */
    function addStroke(group, colorHex, width, opacity, capKind, joinKind) {
        if (group === null || typeof group !== 'object') { return false; }
        var s = ensureProp(group, MN.stroke);
        if (s === null) { return false; }
        var rgb = (colorHex !== null && typeof colorHex === 'object' && colorHex.length === 3)
            ? colorHex : hexToRgb(colorHex);
        var ok = true;
        ok = setSafe(ensureProp(s, MN.strokeColor), [rgb[0], rgb[1], rgb[2], 1]) && ok;
        ok = setSafe(ensureProp(s, MN.strokeWidth), width) && ok;
        ok = setSafe(ensureProp(s, MN.strokeOpacity), opacity) && ok;
        if (typeof capKind === 'number') { setSafe(ensureProp(s, MN.strokeLineCap), capKind); }
        if (typeof joinKind === 'number') { setSafe(ensureProp(s, MN.strokeLineJoin), joinKind); }
        return ok;
    }

    function addFill(group, colorHex, opacity) {
        if (group === null || typeof group !== 'object') { return false; }
        var f = ensureProp(group, MN.fill);
        if (f === null) { return false; }
        var rgb = (colorHex !== null && typeof colorHex === 'object' && colorHex.length === 3)
            ? colorHex : hexToRgb(colorHex);
        var ok = true;
        ok = setSafe(ensureProp(f, MN.fillColor), [rgb[0], rgb[1], rgb[2], 1]) && ok;
        ok = setSafe(ensureProp(f, MN.fillOpacity), opacity) && ok;
        return ok;
    }

    /** Fill OFF: disable first, fall back to opacity 0 (belt and braces). */
    function disableFill(group) {
        if (group === null || typeof group !== 'object') { return false; }
        var f = prop(group, MN.fill);
        if (f === null) { return true; /* nothing to disable */ }
        var ok = true;
        try { f.enabled = false; } catch (eD) { ok = false; }
        if (!ok) { ok = setSafe(ensureProp(f, MN.fillOpacity), 0); }
        return ok;
    }

    /** Stroke OFF (teeth/labels paths carry fill only). */
    function disableStroke(group) {
        if (group === null || typeof group !== 'object') { return false; }
        var s = prop(group, MN.stroke);
        if (s === null) { return true; }
        var ok = true;
        try { s.enabled = false; } catch (eD) { ok = false; }
        if (!ok) { ok = setSafe(ensureProp(s, MN.strokeOpacity), 0); }
        return ok;
    }

    // ----------------------------------------------------------- path builders

    function zeroTangents(n) {
        var a = [];
        for (var i = 0; i < n; i++) { a[a.length] = [0, 0]; }
        return a;
    }

    /** Open 2-point straight segment. */
    function linePath(p0, p1) {
        var s = new Shape();
        s.vertices = [[p0[0], p0[1]], [p1[0], p1[1]]];
        s.inTangents = zeroTangents(2);
        s.outTangents = zeroTangents(2);
        s.closed = false;
        return s;
    }

    /** Straight polyline (zero tangents); closed=false unless requested. */
    function polylinePath(points, closed) {
        var n = points.length;
        var verts = [];
        for (var i = 0; i < n; i++) { verts[verts.length] = [points[i][0], points[i][1]]; }
        var s = new Shape();
        s.vertices = verts;
        s.inTangents = zeroTangents(n);
        s.outTangents = zeroTangents(n);
        s.closed = (closed === true);
        return s;
    }

    /** Closed 4-vertex Bezier ellipse/circle (k = 0.5523 handle ratio). */
    function ellipsePath(size, pos) {
        var rx = size[0] / 2, ry = size[1] / 2;
        var kx = 0.5523 * rx, ky = 0.5523 * ry;
        var cx = pos[0], cy = pos[1];
        var s = new Shape();
        s.vertices = [
            [cx + rx, cy],
            [cx, cy + ry],
            [cx - rx, cy],
            [cx, cy - ry]
        ];
        s.inTangents = [[0, -ky], [kx, 0], [0, ky], [-kx, 0]];
        s.outTangents = [[0, ky], [-kx, 0], [0, -ky], [kx, 0]];
        s.closed = true;
        return s;
    }

    /** Closed axis-aligned rectangle (local w/h at pos = center). */
    function rectPath(w, h, pos) {
        var x0 = pos[0] - w / 2, y0 = pos[1] - h / 2;
        return polylinePath([[x0, y0], [x0 + w, y0], [x0 + w, y0 + h], [x0, y0 + h]], true);
    }

    /** Closed polygon through arbitrary points. */
    function polyPath(points) {
        return polylinePath(points, true);
    }

    var api = {
        MN: MN,
        CAP_BUTT: CAP_BUTT,
        CAP_ROUND: CAP_ROUND,
        JOIN_MITER: JOIN_MITER,
        JOIN_ROUND: JOIN_ROUND,
        hexToRgb: hexToRgb,
        prop: prop,
        ensureProp: ensureProp,
        newShapeLayer: newShapeLayer,
        setLayerTransform: setLayerTransform,
        setLayerRotation: setLayerRotation,
        contentsOf: contentsOf,
        addVectorGroup: addVectorGroup,
        setPath: setPath,
        setEllipse: setEllipse,
        addStroke: addStroke,
        addFill: addFill,
        disableFill: disableFill,
        disableStroke: disableStroke,
        linePath: linePath,
        polylinePath: polylinePath,
        ellipsePath: ellipsePath,
        rectPath: rectPath,
        polyPath: polyPath
    };

    return api;
})();
