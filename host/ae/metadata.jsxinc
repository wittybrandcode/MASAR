// ============================================================================
// TIME RULER — AE Layer Metadata + Instance Registry (ExtendScript ES3)
// ============================================================================
// Module: TR.ae.metadata
// Environment: After Effects 2023+ (ExtendScript ES3). Reads/writes
// layer.comment ONLY (never user artwork); AE DOM access stays in host/ae/*.
//
// Metadata CONTRACT (spec 8.6) — written into layer.comment:
//
//     TIME_RULER|1.0|<instanceId>|<elementId>|<elementType>
//
//   part 0 = product id ("TIME_RULER"), part 1 = schema version ("1.0"),
//   part 2 = 4-digit instance id ("0001"), part 3 = element id
//   (CTRL_MAIN / BASE_RING / MAJOR_TICKS / MINOR_TICKS / MICRO_TICKS / TEETH /
//   LABEL_0007 / MARKER / PROGRESS), part 4 = element type
//   (CONTROLLER / BASE / TICKS / TEETH / LABEL / MARKER / PROGRESS).
//
//   The MASTER CONTROLLER may append a config snapshot:
//
//     ...|CONTROLLER|CFG:<json>
//
//   The JSON may itself contain "|" characters, so parseMetadata() only treats
//   the FIRST FIVE parts as structural; everything after part 4 is ignored
//   payload. When the serialized config exceeds MAX_CFG_CHARS the CFG section
//   is omitted and a truncation-safe note is recorded instead (the instance
//   stays discoverable and re-derivable from the panel's own config state).
//
//   writeMetadata(layer, instanceId, elementId, elementType)
//   parseMetadata(comment) -> {schema, instanceId, elementId, elementType}|null
//   scanInstances(comp)    -> [{instanceId, controllerName, elementCounts,
//                               elementTypes, layerCount}]
//
// ES3 rules: var only, classic loops, try/catch/finally, no ES5 built-ins.
// ============================================================================

var TR = $.global.TIME_RULER;
if (typeof TR === 'undefined') { TR = {}; $.global.TIME_RULER = TR; }
TR.ae = TR.ae || {};
TR.ae.metadata = (function () {

    var PREFIX = 'TIME_RULER';
    var SCHEMA = '1.0';
    /* Config snapshot longer than this is NOT written into the comment. */
    var MAX_CFG_CHARS = 2000;

    // ------------------------------------------------------------------ write

    /**
     * Writes the pipeline metadata into layer.comment. Never throws for a
     * sane layer; returns the written string (or "" when the write failed,
     * which the caller may surface as a warning).
     */
    function writeMetadata(layer, instanceId, elementId, elementType) {
        if (layer === null || typeof layer !== 'object') { return ''; }
        var s = PREFIX + '|' + SCHEMA + '|' + String(instanceId) + '|' +
            String(elementId) + '|' + String(elementType);
        try {
            layer.comment = s;
            return s;
        } catch (eW) {
            if (TR.log) { TR.log('ERROR', 'writeMetadata failed: ' + String(eW && eW.message ? eW.message : eW)); }
            return '';
        }
    }

    /**
     * Appends "|CFG:" + serialized config to a controller comment when it fits
     * the budget; otherwise records a truncation-safe omission note. The base
     * metadata (first 5 parts) is NEVER dropped — the instance stays parseable.
     */
    function appendConfigSnapshot(layer, baseComment, cfg) {
        if (layer === null || typeof layer !== 'object' || typeof baseComment !== 'string' || baseComment.length === 0) {
            return baseComment || '';
        }
        var json = '';
        try { json = TR.JSON.stringify(cfg); } catch (eJ) { json = ''; }
        if (typeof json !== 'string' || json.length === 0) {
            try {
                layer.comment = baseComment + '|CFG:OMITTED_SERIALIZE_FAILED';
            } catch (eS) { /* comment write is best-effort */ }
            return baseComment + '|CFG:OMITTED_SERIALIZE_FAILED';
        }
        if (json.length > MAX_CFG_CHARS) {
            var tooLong = baseComment + '|CFG:OMITTED_SIZE_' + json.length;
            try { layer.comment = tooLong; } catch (eL) { /* best-effort */ }
            return tooLong;
        }
        var full = baseComment + '|CFG:' + json;
        try { layer.comment = full; } catch (eC) { /* best-effort */ }
        return full;
    }

    // ------------------------------------------------------------------ parse

    /**
     * Strict structural parse of the first five "|" parts. Returns
     * {schema, instanceId, elementId, elementType} or null when the comment is
     * not a TIME_RULER pipeline comment (foreign layers yield null).
     */
    function parseMetadata(comment) {
        if (typeof comment !== 'string' || comment.length === 0) { return null; }
        var parts = comment.split('|');
        if (parts.length < 5) { return null; }
        if (parts[0] !== PREFIX) { return null; }
        if (parts[1] !== SCHEMA) { return null; }
        var id = parts[2];
        if (typeof id !== 'string' || !/^\d{4}$/.test(id)) { return null; }
        if (parts[3].length === 0 || parts[4].length === 0) { return null; }
        return {
            schema: parts[1],
            instanceId: id,
            elementId: parts[3],
            elementType: parts[4]
        };
    }

    // ------------------------------------------------------------------ scan

    /**
     * Scans every layer of `comp` for pipeline comments and groups them by
     * instance. The reliable scripting API is comp.layer(index) for
     * index = 1..comp.numLayers (LayerCollection is 1-based, documented).
     * Foreign layers (null parse) are ignored entirely.
     */
    function scanInstances(comp) {
        var out = [];
        if (comp === null || typeof comp !== 'object') { return out; }
        var numLayers = 0;
        try { numLayers = comp.numLayers; } catch (eN) { numLayers = 0; }

        var byId = {};
        var order = [];
        for (var i = 1; i <= numLayers; i++) {
            var layer = null;
            try { layer = comp.layer(i); } catch (eL) {
                try { layer = comp.layers[i]; } catch (eL2) { layer = null; }
            }
            if (layer === null || typeof layer !== 'object') { continue; }
            var meta = null;
            try { meta = parseMetadata(layer.comment); } catch (eC) { meta = null; }
            if (meta === null) { continue; }

            var inst = byId[meta.instanceId];
            if (typeof inst === 'undefined' || inst === null) {
                inst = {
                    instanceId: meta.instanceId,
                    controllerName: null,
                    elementCounts: {},
                    elementTypes: [],
                    layerCount: 0
                };
                byId[meta.instanceId] = inst;
                order[order.length] = inst;
            }
            inst.layerCount = inst.layerCount + 1;
            var key = meta.elementType;
            var cur = inst.elementCounts[key];
            inst.elementCounts[key] = (typeof cur === 'number') ? (cur + 1) : 1;
            if (inst.elementCounts[key] === 1) { inst.elementTypes[inst.elementTypes.length] = key; }
            if (key === 'CONTROLLER') {
                try { inst.controllerName = String(layer.name); } catch (eNm) { inst.controllerName = null; }
            }
        }
        /* order[] preserves first-appearance order of the instance ids. */
        var j;
        for (j = 0; j < order.length; j++) { out[out.length] = order[j]; }
        return out;
    }

    /**
     * Next free 4-digit instance id ("0001"...), smallest unused. Returns
     * null when the comp is saturated (caller maps that to TOO_MANY_INSTANCES).
     */
    function nextInstanceId(comp) {
        var used = {};
        var instances = scanInstances(comp);
        for (var i = 0; i < instances.length; i++) {
            used[instances[i].instanceId] = true;
        }
        for (var n = 1; n <= 9999; n++) {
            var id = pad4(n);
            if (used[id] !== true) { return id; }
        }
        return null;
    }

    function pad4(n) {
        var s = String(n);
        while (s.length < 4) { s = '0' + s; }
        return s;
    }

    /**
     * Extracts and parses the JSON config snapshot appended to a controller
     * comment. Returns the parsed config object or null when not found / omitted.
     */
    function extractConfigSnapshot(comment) {
        if (typeof comment !== 'string' || comment.length === 0) { return null; }
        var idx = comment.indexOf('|CFG:');
        if (idx === -1) { return null; }
        var payload = comment.substring(idx + 5);
        if (payload.indexOf('OMITTED_') === 0) { return null; }
        return TR.JSON.parse(payload);
    }

    var api = {
        PREFIX: PREFIX,
        SCHEMA: SCHEMA,
        MAX_CFG_CHARS: MAX_CFG_CHARS,
        writeMetadata: writeMetadata,
        appendConfigSnapshot: appendConfigSnapshot,
        extractConfigSnapshot: extractConfigSnapshot,
        parseMetadata: parseMetadata,
        scanInstances: scanInstances,
        nextInstanceId: nextInstanceId,
        pad4: pad4
    };

    return api;
})();
