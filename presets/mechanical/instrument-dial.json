{
  "schemaVersion": "1.0",
  "product": "TIME_RULER",
  "preset": {
    "id": "instrument-dial",
    "name": "Mechanical Instrument Dial",
    "description": "Instrument dial 0-100 with dense minor/micro graduations and 120 mechanical teeth around the outer edge.",
    "builtin": true
  },
  "geometry": {
    "type": "circular",
    "centerMode": "compositionCenter",
    "center": [960, 540],
    "radius": 0,
    "startAngle": -90,
    "sweepAngle": 360,
    "direction": "clockwise",
    "distributionMode": "bounded",
    "seamGapDegrees": 6,
    "orientation": "radial",
    "linearOrientation": "horizontal",
    "startX": 0,
    "startY": 0,
    "length": 800,
    "linearDirection": "forward",
    "tickSide": "both",
    "labelOffset": 20
  },
  "time": {
    "mode": "numeric",
    "start": 0,
    "end": 100,
    "majorStep": 10,
    "minorDivisions": 10,
    "microDivisions": 2,
    "includeEndPoint": true,
    "precision": 0,
    "prefix": "",
    "suffix": "",
    "timeZone": "UTC",
    "startDate": "",
    "endDate": "",
    "calendarUnit": "years",
    "dateFormat": "",
    "frameRateMode": "comp",
    "customFps": 25,
    "dropFrame": false
  },
  "graduations": {
    "major": { "enabled": true, "length": 22, "width": 3, "offset": 0, "color": "#E8E8E8", "opacity": 100 },
    "minor": { "enabled": true, "length": 10, "width": 2, "offset": 0, "color": "#9AA0A6", "opacity": 85 },
    "micro": { "enabled": true, "length": 5, "width": 1, "offset": 0, "color": "#6E7681", "opacity": 60 }
  },
  "baseline": { "enabled": true, "width": 2, "color": "#E8E8E8" },
  "typography": {
    "enabled": true,
    "fontName": "Arial",
    "fontSize": 26,
    "tracking": 0,
    "color": "#E8E8E8",
    "orientation": "radial",
    "radiusOffset": 48,
    "precision": 0,
    "collisionMode": "allow_overlap",
    "labelEvery": 1
  },
  "teeth": {
    "enabled": true,
    "count": 120,
    "shape": "rectangle",
    "width": 3,
    "height": 8,
    "alignment": "outer",
    "rotationOffset": 0,
    "color": "#F2A33C",
    "opacity": 100
  },
  "indicators": {
    "marker": true,
    "progress": false,
    "highlight": false,
    "markerColor": "#F2A33C",
    "markerSize": 12,
    "highlightColor": "#F2A33C"
  },
  "output": {
    "mode": "generator",
    "granularity": "grouped",
    "editableTextLayers": true,
    "createMasterController": true
  },
  "animation": {
    "progress": 0,
    "reveal": 100,
    "rotationOffset": 0,
    "highlightStart": 0,
    "highlightEnd": 100
  }
}
