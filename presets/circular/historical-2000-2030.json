{
  "schemaVersion": "1.0",
  "product": "TIME_RULER",
  "preset": {
    "id": "historical-2000-2030",
    "name": "Historical Circular 2000-2030",
    "description": "31 years spread over a full circle with a 6-degree seam gap. Bounded timeline: first and last years never overlap.",
    "builtin": true
  },
  "geometry": {
    "type": "circular",
    "centerMode": "compositionCenter",
    "center": [960, 540],
    "radius": 0,
    "startAngle": -90,
    "sweepAngle": 360,
    "direction": "clockwise",
    "distributionMode": "bounded",
    "seamGapDegrees": 6,
    "orientation": "radial",
    "linearOrientation": "horizontal",
    "startX": 0,
    "startY": 0,
    "length": 800,
    "linearDirection": "forward",
    "tickSide": "both",
    "labelOffset": 20
  },
  "time": {
    "mode": "numeric",
    "start": 2000,
    "end": 2030,
    "majorStep": 1,
    "minorDivisions": 4,
    "microDivisions": 0,
    "includeEndPoint": true,
    "precision": 0,
    "prefix": "",
    "suffix": "",
    "timeZone": "UTC",
    "startDate": "",
    "endDate": "",
    "calendarUnit": "years",
    "dateFormat": "",
    "frameRateMode": "comp",
    "customFps": 25,
    "dropFrame": false
  },
  "graduations": {
    "major": { "enabled": true, "length": 24, "width": 3, "offset": 0, "color": "#2878D0", "opacity": 100 },
    "minor": { "enabled": true, "length": 12, "width": 2, "offset": 0, "color": "#75A9E8", "opacity": 85 },
    "micro": { "enabled": false, "length": 6, "width": 1, "offset": 0, "color": "#A9C7EA", "opacity": 70 }
  },
  "baseline": { "enabled": true, "width": 2, "color": "#2878D0" },
  "typography": {
    "enabled": true,
    "fontName": "Arial",
    "fontSize": 30,
    "tracking": 0,
    "color": "#2878D0",
    "orientation": "radial",
    "radiusOffset": 52,
    "precision": 0,
    "collisionMode": "alternate",
    "labelEvery": 1
  },
  "teeth": {
    "enabled": false,
    "count": 120,
    "shape": "rectangle",
    "width": 3,
    "height": 8,
    "alignment": "outer",
    "rotationOffset": 0,
    "color": "#2878D0",
    "opacity": 100
  },
  "indicators": {
    "marker": true,
    "progress": false,
    "highlight": false,
    "markerColor": "#FFFFFF",
    "markerSize": 10,
    "highlightColor": "#F2A33C"
  },
  "output": {
    "mode": "generator",
    "granularity": "grouped",
    "editableTextLayers": true,
    "createMasterController": true
  },
  "animation": {
    "progress": 0,
    "reveal": 100,
    "rotationOffset": 0,
    "highlightStart": 0,
    "highlightEnd": 100
  }
}
