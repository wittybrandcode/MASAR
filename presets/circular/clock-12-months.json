{
  "schemaVersion": "1.0",
  "product": "TIME_RULER",
  "preset": {
    "id": "clock-12-months",
    "name": "12 Months Clock",
    "description": "Cyclic yearly clock, January to December. End-exclusive distribution: January never repeats at the closure point.",
    "builtin": true
  },
  "geometry": {
    "type": "circular",
    "centerMode": "compositionCenter",
    "center": [960, 540],
    "radius": 0,
    "startAngle": -90,
    "sweepAngle": 360,
    "direction": "clockwise",
    "distributionMode": "cyclic",
    "seamGapDegrees": 0,
    "orientation": "radial",
    "linearOrientation": "horizontal",
    "startX": 0,
    "startY": 0,
    "length": 800,
    "linearDirection": "forward",
    "tickSide": "both",
    "labelOffset": 20
  },
  "time": {
    "mode": "calendar",
    "start": 2000,
    "end": 2030,
    "majorStep": 1,
    "minorDivisions": 3,
    "microDivisions": 0,
    "includeEndPoint": false,
    "precision": 0,
    "prefix": "",
    "suffix": "",
    "timeZone": "UTC",
    "startDate": "2026-01-01",
    "endDate": "2027-01-01",
    "calendarUnit": "months",
    "dateFormat": "",
    "frameRateMode": "comp",
    "customFps": 25,
    "dropFrame": false
  },
  "graduations": {
    "major": { "enabled": true, "length": 20, "width": 3, "offset": 0, "color": "#E8E8E8", "opacity": 100 },
    "minor": { "enabled": true, "length": 9, "width": 2, "offset": 0, "color": "#9AA0A6", "opacity": 80 },
    "micro": { "enabled": false, "length": 5, "width": 1, "offset": 0, "color": "#6E7681", "opacity": 60 }
  },
  "baseline": { "enabled": true, "width": 2, "color": "#E8E8E8" },
  "typography": {
    "enabled": true,
    "fontName": "Arial",
    "fontSize": 34,
    "tracking": 0,
    "color": "#E8E8E8",
    "orientation": "radial",
    "radiusOffset": 55,
    "precision": 0,
    "collisionMode": "allow_overlap",
    "labelEvery": 1
  },
  "teeth": {
    "enabled": false,
    "count": 120,
    "shape": "rectangle",
    "width": 3,
    "height": 8,
    "alignment": "outer",
    "rotationOffset": 0,
    "color": "#E8E8E8",
    "opacity": 100
  },
  "indicators": {
    "marker": true,
    "progress": false,
    "highlight": false,
    "markerColor": "#FFFFFF",
    "markerSize": 10,
    "highlightColor": "#F2A33C"
  },
  "output": {
    "mode": "generator",
    "granularity": "grouped",
    "editableTextLayers": true,
    "createMasterController": true
  },
  "animation": {
    "progress": 0,
    "reveal": 100,
    "rotationOffset": 0,
    "highlightStart": 0,
    "highlightEnd": 100
  }
}
