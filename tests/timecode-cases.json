{
  "note": "TIME RULER M4 timecode-engine cases (spec 2.4 + 12.2 timecode part). Run by tests/host-core-tests.jsx via TR.core.timecode. expect.throws = error.code. NOTE: '59.94DF frame 1800 -> 00:01:00;04' from the build task is a vector error — at 60 nominal fps frame 1800 is 30s into minute 0 (no drop region) -> 00:00:30;00; the published pair is frame 3600 -> 00:01:00;04. Both are asserted below.",
  "cases": [
    { "id": "tc_25fps_0_10", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 10, "majorStep": 1, "frameRateMode": "custom", "customFps": 25 } },
      "expect": { "count": 11, "cyclic": false, "endIncluded": false,
        "fields": { "fps": 25, "num": 25, "den": 1, "nominal": 25, "dropFrame": false },
        "first": { "index": 0, "t": 0, "seconds": 0, "frame": 0, "label": "00:00:00:00" },
        "itemAt": { "index": 10, "t": 1, "seconds": 10, "frame": 250, "label": "00:00:10:00" },
        "tAscending": true } },

    { "id": "tc_seq_24fps_0_2", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 2, "majorStep": 1, "frameRateMode": "custom", "customFps": 24 } },
      "expect": { "count": 3, "endIncluded": false,
        "fields": { "num": 24, "den": 1, "nominal": 24 },
        "itemAt": { "index": 1, "frame": 24, "label": "00:00:01:00" },
        "last": { "index": 2, "frame": 48, "label": "00:00:02:00", "t": 1 } } },

    { "id": "tc_seq_include_end_nondivisible", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 10, "majorStep": 3, "frameRateMode": "custom", "customFps": 25, "includeEndPoint": true } },
      "expect": { "count": 5, "endIncluded": true,
        "first": { "index": 0, "frame": 0, "label": "00:00:00:00" },
        "itemAt": { "index": 3, "frame": 225, "label": "00:00:09:00", "t": 0.9 },
        "last": { "index": 4, "t": 1, "frame": 250, "label": "00:00:10:00" },
        "tAscending": true,
        "note": "0,3,6,9 full steps (t value-based) + appended 10s end item t=1 endIncluded=true" } },

    { "id": "tc_seq_df_forced_off_25", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 10, "majorStep": 1, "frameRateMode": "custom", "customFps": 25, "dropFrame": true } },
      "expect": { "count": 11,
        "fields": { "dropFrame": false, "num": 25, "den": 1 },
        "itemAt": { "index": 1, "frame": 25, "label": "00:00:01:00" },
        "note": "dropFrame requested at 25fps: not allowed -> forced false, ND separators, no crash" } },

    { "id": "tc_seq_2997_df", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 10, "majorStep": 1, "frameRateMode": "custom", "customFps": 29.97, "dropFrame": true } },
      "expect": { "count": 11,
        "fields": { "fps": 29.97002997002997, "num": 30000, "den": 1001, "nominal": 30, "dropFrame": true },
        "itemAt": { "index": 1, "seconds": 1, "frame": 30, "label": "00:00:01;00" },
        "itemNote": "second 1 -> frame round(1*30000/1001)=30 -> DF label ;00 separator" } },

    { "id": "tc_seq_zero_domain", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 5, "end": 5, "majorStep": 1, "frameRateMode": "custom", "customFps": 25 } },
      "expect": { "throws": "TIME_RANGE_EMPTY" } },
    { "id": "tc_seq_bad_step", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 10, "majorStep": 0, "frameRateMode": "custom", "customFps": 25 } },
      "expect": { "throws": "INVALID_MAJOR_STEP" } },
    { "id": "tc_seq_wrong_mode", "kind": "timecode",
      "input": { "timeCfg": { "mode": "calendar", "start": 0, "end": 10, "majorStep": 1 }, "compInfo": { "frameRate": 25 } },
      "expect": { "throws": "UNSUPPORTED_TIME_MODE" } },
    { "id": "tc_seq_comp_mode_ok", "kind": "timecode",
      "input": { "timeCfg": { "mode": "timecode", "start": 0, "end": 2, "majorStep": 1, "frameRateMode": "comp" }, "compInfo": { "frameRate": 24, "width": 1920, "height": 1080 } },
      "expect": { "count": 3, "fields": { "num": 24, "den": 1, "nominal": 24 },
        "last": { "frame": 48, "label": "00:00:02:00" } } },

    { "id": "tc_resolve_25", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 25 } },
      "expect": { "fields": { "fps": 25, "num": 25, "den": 1, "nominal": 25, "dropFrameAllowed": false } } },
    { "id": "tc_resolve_24", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 24 } },
      "expect": { "fields": { "fps": 24, "num": 24, "den": 1, "nominal": 24, "dropFrameAllowed": false } } },
    { "id": "tc_resolve_2997", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 29.97 } },
      "expect": { "fields": { "fps": 29.97002997002997, "num": 30000, "den": 1001, "nominal": 30, "dropFrameAllowed": true } } },
    { "id": "tc_resolve_5994", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 59.94 } },
      "expect": { "fields": { "fps": 59.94005994005994, "num": 60000, "den": 1001, "nominal": 60, "dropFrameAllowed": true } } },
    { "id": "tc_resolve_23976_not_df", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 23.976 } },
      "expect": { "fields": { "num": 24000, "den": 1001, "nominal": 24, "dropFrameAllowed": false },
        "note": "23.976 family: rational but NOT drop-frame (spec 2.4: DF only for 29.97/59.94)" } },
    { "id": "tc_resolve_exact_rational_decimal", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 29.97002997002997 } },
      "expect": { "fields": { "num": 30000, "den": 1001 }, "note": "the exact 30000/1001 double must map back to the rational" } },
    { "id": "tc_resolve_30_integer", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 30 } },
      "expect": { "fields": { "num": 30, "den": 1, "nominal": 30, "dropFrameAllowed": false } } },
    { "id": "tc_resolve_decimal_approx", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 12.5 } },
      "expect": { "fields": { "num": 12500, "den": 1000, "nominal": 13, "dropFrameAllowed": false },
        "note": "non-standard decimal -> round(fps*1000)/1000 documented v1 approximation" } },
    { "id": "tc_resolve_comp_unavailable", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "comp" } },
      "expect": { "throws": "FPS_UNAVAILABLE", "note": "no compInfo at all" } },
    { "id": "tc_resolve_comp_zero_fps", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "comp" }, "compInfo": { "frameRate": 0 } },
      "expect": { "throws": "FPS_UNAVAILABLE" } },
    { "id": "tc_resolve_comp_ok", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "comp" }, "compInfo": { "frameRate": 29.97 } },
      "expect": { "fields": { "num": 30000, "den": 1001, "nominal": 30, "dropFrameAllowed": true } } },
    { "id": "tc_resolve_custom_zero", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": 0 } },
      "expect": { "throws": "TC_FPS_INVALID" } },
    { "id": "tc_resolve_custom_negative", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "custom", "customFps": -5 } },
      "expect": { "throws": "TC_FPS_INVALID" } },
    { "id": "tc_resolve_bad_mode", "kind": "resolveFps",
      "input": { "timeCfg": { "frameRateMode": "magic", "customFps": 25 } },
      "expect": { "throws": "ENUM_FPS_MODE" } },

    { "id": "tc_str_25_250", "kind": "timecodeString", "input": { "frame": 250, "num": 25, "den": 1, "drop": false }, "expect": { "equals": "00:00:10:00" } },
    { "id": "tc_str_24_48", "kind": "timecodeString", "input": { "frame": 48, "num": 24, "den": 1, "drop": false }, "expect": { "equals": "00:00:02:00" } },
    { "id": "tc_str_2997_nd_1800", "kind": "timecodeString", "input": { "frame": 1800, "num": 30000, "den": 1001, "drop": false }, "expect": { "equals": "00:01:00:00" } },
    { "id": "tc_str_23976_nd_1800", "kind": "timecodeString", "input": { "frame": 1800, "num": 24000, "den": 1001, "drop": false }, "expect": { "equals": "00:01:15:00" } },

    { "id": "tc_str_2997_df_0", "kind": "timecodeString", "input": { "frame": 0, "num": 30000, "den": 1001, "drop": true }, "expect": { "equals": "00:00:00;00" } },
    { "id": "tc_str_2997_df_1800", "kind": "timecodeString", "input": { "frame": 1800, "num": 30000, "den": 1001, "drop": true }, "expect": { "equals": "00:01:00;02" } },
    { "id": "tc_str_2997_df_17982", "kind": "timecodeString", "input": { "frame": 17982, "num": 30000, "den": 1001, "drop": true }, "expect": { "equals": "00:10:00;00" } },
    { "id": "tc_str_2997_df_17999", "kind": "timecodeString", "input": { "frame": 17999, "num": 30000, "den": 1001, "drop": true }, "expect": { "equals": "00:10:00;17" } },
    { "id": "tc_str_2997_df_3597", "kind": "timecodeString", "input": { "frame": 3597, "num": 30000, "den": 1001, "drop": true }, "expect": { "equals": "00:01:59;29" } },

    { "id": "tc_str_5994_df_3600", "kind": "timecodeString", "input": { "frame": 3600, "num": 60000, "den": 1001, "drop": true }, "expect": { "equals": "00:01:00;04" } },
    { "id": "tc_str_5994_df_1800", "kind": "timecodeString", "input": { "frame": 1800, "num": 60000, "den": 1001, "drop": true }, "expect": { "equals": "00:00:30;00", "note": "task-vector correction: 1800/60 = 30s, minute 0 has no drops" } },
    { "id": "tc_str_5994_df_35964", "kind": "timecodeString", "input": { "frame": 35964, "num": 60000, "den": 1001, "drop": true }, "expect": { "equals": "00:10:00;00" } },
    { "id": "tc_str_5994_df_35963", "kind": "timecodeString", "input": { "frame": 35963, "num": 60000, "den": 1001, "drop": true }, "expect": { "equals": "00:09:59;59" } },

    { "id": "tc_str_df_fallback_25", "kind": "timecodeString", "input": { "frame": 250, "num": 25, "den": 1, "drop": true }, "expect": { "equals": "00:00:10:00", "note": "drop requested where not allowed -> silent ND fallback, no crash" } },
    { "id": "tc_str_df_fallback_23976", "kind": "timecodeString", "input": { "frame": 3600, "num": 24000, "den": 1001, "drop": true }, "expect": { "equals": "00:02:30:00", "note": "23.976 is never drop-frame -> ND counting" } },

    { "id": "tc_frame_from_seconds_10s_2997", "kind": "frameFromSeconds", "input": { "seconds": 10, "num": 30000, "den": 1001 }, "expect": { "equals": 300 } },
    { "id": "tc_frame_from_seconds_1s_23976", "kind": "frameFromSeconds", "input": { "seconds": 1, "num": 24000, "den": 1001 }, "expect": { "equals": 24 } }
  ]
}
