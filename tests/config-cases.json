{
  "note": "TIME RULER config-level cases (spec 12.2, config schema 1.0). Kind buildTickPlan. The engine performs NO density capping: oversized configs compute fully here; caps (spec 11.1: majors<=500, minor+micro<=2000, labels<=200) belong to the validation lane.",
  "cases": [
    {
      "id": "c_default_circular_bounded",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "circular", "centerMode": "custom", "center": { "x": 960, "y": 540 },
            "radius": 300, "startAngle": -90, "sweepAngle": 360,
            "direction": "clockwise", "distributionMode": "bounded", "seamGapDegrees": 6
          },
          "time": { "mode": "numeric", "start": 2000, "end": 2030, "majorStep": 1, "minorDivisions": 4, "microDivisions": 0, "includeEndPoint": false, "precision": 0, "prefix": "", "suffix": "" },
          "graduations": {
            "major": { "enabled": true, "length": 24, "width": 4, "offset": 0, "opacity": 100 },
            "minor": { "enabled": true, "length": 12, "width": 2, "offset": 0, "opacity": 80 },
            "micro": { "enabled": false, "length": 6, "width": 1, "offset": 0, "opacity": 60 }
          },
          "typography": { "enabled": true, "radiusOffset": 40, "orientation": "radial", "fontSize": 20 }
        }
      },
      "expect": {
        "type": "circular",
        "baselineKind": "arc",
        "sweep": 354,
        "majorCount": 31,
        "minorCount": 90,
        "microCount": 0,
        "labelCount": 31,
        "note": "default config: 31 majors, 90 minors (30 intervals x (4-1)), 0 micro (disabled), 31 labels (collision handling may change DISPLAY later but the plan keeps 31)"
      }
    },
    {
      "id": "c_teeth_disabled_no_teeth_plan",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "circular", "centerMode": "custom", "center": { "x": 0, "y": 0 },
            "radius": 200, "startAngle": -90, "sweepAngle": 360,
            "direction": "clockwise", "distributionMode": "bounded", "seamGapDegrees": 6
          },
          "time": { "mode": "numeric", "start": 2000, "end": 2030, "majorStep": 1, "precision": 0 },
          "graduations": {},
          "typography": { "enabled": true, "radiusOffset": 30 },
          "teeth": { "enabled": false, "count": 60 }
        }
      },
      "expect": {
        "majorCount": 31,
        "teethAbsent": true,
        "note": "teeth disabled -> plan.teeth is null (no teeth plan)"
      }
    },
    {
      "id": "c_teeth_enabled_uniform",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "circular", "centerMode": "custom", "center": { "x": 0, "y": 0 },
            "radius": 200, "startAngle": -90, "sweepAngle": 360,
            "direction": "clockwise", "distributionMode": "bounded", "seamGapDegrees": 6
          },
          "time": { "mode": "numeric", "start": 2000, "end": 2030, "majorStep": 1, "precision": 0 },
          "graduations": {},
          "typography": { "enabled": true, "radiusOffset": 30 },
          "teeth": { "enabled": true, "count": 12 }
        }
      },
      "expect": {
        "teethCount": 12,
        "note": "teeth enabled -> uniform teeth items over the effective sweep (optional LayoutPlan extension)"
      }
    },
    {
      "id": "c_oversized_0_100000_no_cap",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "circular", "centerMode": "custom", "center": { "x": 960, "y": 540 },
            "radius": 300, "startAngle": -90, "sweepAngle": 360,
            "direction": "clockwise", "distributionMode": "bounded", "seamGapDegrees": 6
          },
          "time": { "mode": "numeric", "start": 0, "end": 100000, "majorStep": 1000, "minorDivisions": 2, "precision": 0 },
          "graduations": { "minor": { "enabled": true } },
          "typography": { "enabled": true, "radiusOffset": 30 }
        }
      },
      "expect": {
        "majorCount": 101,
        "minorCount": 100,
        "labelCount": 101,
        "note": "end-start = 100000: engine computes WITHOUT capping (101 majors, 100 minors); spec 11.1 caps are enforced by the validation lane, not here"
      }
    },
    {
      "id": "c_linear_default",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "linear", "linearOrientation": "horizontal",
            "startX": 100, "startY": 540, "length": 800,
            "linearDirection": "forward", "tickSide": "positive", "labelOffset": 24
          },
          "time": { "mode": "numeric", "start": 0, "end": 90, "majorStep": 10, "minorDivisions": 2, "precision": 0 },
          "graduations": {
            "major": { "enabled": true, "length": 20 },
            "minor": { "enabled": true, "length": 10 },
            "micro": { "enabled": false }
          },
          "typography": { "enabled": true, "fontSize": 18 }
        }
      },
      "expect": {
        "type": "linear",
        "baselineKind": "line",
        "majorCount": 10,
        "minorCount": 9,
        "microCount": 0,
        "labelCount": 10,
        "labelAt": { "index": 0, "text": "0", "x": 100, "y": 564 },
        "labelLast": { "text": "90", "x": 900, "y": 564 }
      }
    },
    {
      "id": "c_cyclic_seconds_full_circle",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "circular", "centerMode": "comp_center",
            "radius": 260, "startAngle": 0, "sweepAngle": 360,
            "direction": "clockwise", "distributionMode": "cyclic"
          },
          "time": { "mode": "numeric", "start": 0, "end": 59, "majorStep": 1, "minorDivisions": 4, "precision": 0 },
          "graduations": { "minor": { "enabled": true } },
          "typography": { "enabled": true, "radiusOffset": 34 }
        },
        "compInfo": { "width": 1920, "height": 1080 }
      },
      "expect": {
        "type": "circular",
        "baselineKind": "circle",
        "sweep": 360,
        "majorCount": 60,
        "minorCount": 180,
        "labelCount": 60,
        "majorAnglesAscending": true,
        "labelLast": { "text": "59", "angleDeg": 354 },
        "note": "comp_center resolves to (960, 540); cyclic 60 seconds, END-EXCLUSIVE"
      }
    },
    {
      "id": "c_include_endpoint_micro_mixed",
      "kind": "buildTickPlan",
      "input": {
        "cfg": {
          "geometry": {
            "type": "circular", "centerMode": "custom", "center": { "x": 0, "y": 0 },
            "radius": 100, "startAngle": 0, "sweepAngle": 360,
            "direction": "clockwise", "distributionMode": "bounded", "seamGapDegrees": 6
          },
          "time": { "mode": "numeric", "start": 0, "end": 10, "majorStep": 2.5, "minorDivisions": 5, "microDivisions": 2, "includeEndPoint": false, "precision": 1 },
          "graduations": { "minor": { "enabled": true }, "micro": { "enabled": true } },
          "typography": { "enabled": true, "radiusOffset": 15 }
        }
      },
      "expect": {
        "majorCount": 5,
        "minorCount": 16,
        "microCount": 20,
        "labelCount": 5,
        "labelLast": { "text": "10.0", "angleDeg": 354 },
        "note": "divisible (10/2.5=4): majors 0,2.5,5,7.5,10; minors 4 intervals x (5-1) = 16; micro 4x5x1 = 20; precision 1 -> '10.0'"
      }
    }
  ]
}
