    },
    {
      "id": "g_dl_vertical_reverse",
      "kind": "distributeLinear",
      "input": { "count": 5, "startX": 50, "startY": 60, "length": 100, "orientation": "vertical", "direction": "reverse" },
      "expect": { "count": 5, "first": { "x": 50, "y": 60, "dirSign": -1 }, "last": { "x": 50, "y": -40 } }
    },
    {
      "id": "g_dl_count1_midpoint",
