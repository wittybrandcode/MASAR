      "input": { "count": 8, "startAngleDeg": 0, "sweepDeg": 137 },
      "expect": { "count": 8, "first": { "angleDeg": 0 }, "last": { "angleDeg": 137 }, "angleStep": 19.571428571428573, "note": "custom sweep: count-1 = 7 equal intervals" }
