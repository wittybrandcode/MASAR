{
  "note": "TIME RULER geometry/numeric cases (spec 12.1 + 12.2). Run by tests/host-core-tests.jsx. Numerics use tol (default 1e-6). Angles are raw (not normalized). expect.throws = error.code.",
  "cases": [
    { "id": "g_d2r_0", "kind": "degToRad", "input": { "deg": 0 }, "expect": { "fields": { "rad": 0 } } },
    { "id": "g_d2r_180", "kind": "degToRad", "input": { "deg": 180 }, "expect": { "fields": { "rad": 3.141592653589793 } } },

    { "id": "g_poc_neg90_top", "kind": "pointOnCircle", "input": { "cx": 0, "cy": 0, "radius": 100, "angleDeg": -90 }, "expect": { "fields": { "x": 0, "y": -100 }, "note": "-90 = top of circle (y < cy), screen coords y down" } },
    { "id": "g_poc_0_right", "kind": "pointOnCircle", "input": { "cx": 0, "cy": 0, "radius": 100, "angleDeg": 0 }, "expect": { "fields": { "x": 100, "y": 0 }, "note": "0 = right (x = cx + radius)" } },
    { "id": "g_poc_90_bottom", "kind": "pointOnCircle", "input": { "cx": 0, "cy": 0, "radius": 100, "angleDeg": 90 }, "expect": { "fields": { "x": 0, "y": 100 }, "note": "90 = bottom (y > cy)" } },
    { "id": "g_poc_180_left", "kind": "pointOnCircle", "input": { "cx": 0, "cy": 0, "radius": 100, "angleDeg": 180 }, "expect": { "fields": { "x": -100, "y": 0 }, "note": "180 = left" } },
    { "id": "g_poc_270_top", "kind": "pointOnCircle", "input": { "cx": 0, "cy": 0, "radius": 100, "angleDeg": 270 }, "expect": { "fields": { "x": 0, "y": -100 } } },
    { "id": "g_poc_360_same_as_0", "kind": "pointOnCircle", "input": { "cx": 0, "cy": 0, "radius": 100, "angleDeg": 360 }, "expect": { "fields": { "x": 100, "y": 0 } } },
    { "id": "g_poc_offset_center", "kind": "pointOnCircle", "input": { "cx": 500, "cy": 300, "radius": 80, "angleDeg": -90 }, "expect": { "fields": { "x": 500, "y": 220 } } },

    { "id": "g_ov_neg90", "kind": "outVector", "input": { "angleDeg": -90 }, "expect": { "fields": { "ux": 0, "uy": -1 }, "note": "outward at top points up (uy negative)" } },
    { "id": "g_ov_0", "kind": "outVector", "input": { "angleDeg": 0 }, "expect": { "fields": { "ux": 1, "uy": 0 } } },
    { "id": "g_ov_90", "kind": "outVector", "input": { "angleDeg": 90 }, "expect": { "fields": { "ux": 0, "uy": 1 } } },
    { "id": "g_ov_180", "kind": "outVector", "input": { "angleDeg": 180 }, "expect": { "fields": { "ux": -1, "uy": 0 } } },

    {
      "id": "g_dc_bounded_2000_2030",
      "kind": "distributeCircular",
      "input": { "count": 31, "startAngleDeg": -90, "sweepDeg": 360, "mode": "bounded", "seamGapDegrees": 6 },
      "expect": {
        "count": 31,
        "first": { "index": 0, "t": 0, "angleDeg": -90 },
        "last": { "index": 30, "t": 1, "angleDeg": 264 },
        "note": "bounded 360 with seamGap 6 -> effective sweep 354; step = 354/30 = 11.8",
        "anglesAscending": true,
        "angleStep": 11.8
      }
    },
    {
      "id": "g_dc_bounded_count1_midpoint",
      "kind": "distributeCircular",
      "input": { "count": 1, "startAngleDeg": -90, "sweepDeg": 360, "mode": "bounded", "seamGapDegrees": 6 },
      "expect": { "count": 1, "itemAt": { "index": 0, "t": 0.5, "angleDeg": 87 }, "note": "count 1 -> midpoint of effective sweep, no division by zero" }
    },
    {
      "id": "g_dc_bounded_sweep180_no_seam",
      "kind": "distributeCircular",
      "input": { "count": 7, "startAngleDeg": 0, "sweepDeg": 180, "mode": "bounded", "seamGapDegrees": 6 },
      "expect": { "count": 7, "first": { "angleDeg": 0 }, "last": { "angleDeg": 180 }, "angleStep": 30, "note": "sweep < 360 -> seamGap NOT applied" }
    },
    {
      "id": "g_dc_cyclic_60_seconds",
      "kind": "distributeCircular",
      "input": { "count": 60, "startAngleDeg": 0, "sweepDeg": 360, "mode": "cyclic" },
      "expect": {
        "count": 60,
        "first": { "index": 0, "t": 0, "angleDeg": 0 },
        "last": { "index": 59, "t": 0.9833333333333333, "angleDeg": 354 },
        "note": "cyclic END-EXCLUSIVE: angle(i) = 360*i/60, max 354, no 360, no 0 duplicate",
        "anglesAscending": true,
        "angleStep": 6,
        "maxAngleDeg": 354,
        "noAngleNear": 360,
        "anglesUnique": true
      }
    },
    {
      "id": "g_dc_cyclic_12_months",
      "kind": "distributeCircular",
      "input": { "count": 12, "startAngleDeg": -90, "sweepDeg": 360, "mode": "cyclic" },
      "expect": { "count": 12, "first": { "angleDeg": -90 }, "last": { "angleDeg": 240 }, "angleStep": 30, "noAngleNear": 270, "note": "12 months cyclic: no repeat of month 1 at closure (-90+360 = 270 absent)" }
    },

