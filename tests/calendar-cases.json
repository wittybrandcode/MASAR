{
  "note": "TIME RULER M4 calendar-engine cases (spec 2.4 + 12.2 calendar part). Run by tests/host-core-tests.jsx via TR.core.calendarTime. expect.throws = error.code. ms values are absolute UTC ms (UTC zone cases are deterministic; LOCAL cases assert only counts/order).",
  "cases": [
    { "id": "cal_cyclic_12_months", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2027-01-01", "calendarUnit": "months", "distributionMode": "cyclic", "timeZone": "UTC", "includeEndPoint": false } },
      "expect": { "count": 12, "cyclic": true, "endIncluded": false,
        "first": { "index": 0, "t": 0, "ms": 1767225600000, "label": "Jan", "valueISO": "2026-01-01" },
        "last": { "index": 11, "t": 0.9166666666666666, "label": "Dec", "valueISO": "2026-12-01" },
        "labelsArray": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
        "tAscending": true,
        "note": "spec 12.2: 12 cyclic months -> 12 positions, END-EXCLUSIVE (no January repeat at closure); t = i/count" } },

    { "id": "cal_bounded_months_jan_jul", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2026-07-01", "calendarUnit": "months", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 7, "cyclic": false, "endIncluded": false,
        "first": { "index": 0, "t": 0, "label": "Jan", "valueISO": "2026-01-01" },
        "itemAt": { "index": 5, "label": "Jun", "t": 0.8342541436464088, "ms": 1780272000000 },
        "last": { "index": 6, "label": "Jul", "t": 1 },
        "tAscending": true,
        "note": "t(Jun 1) = 151/181 REAL duration fraction (unequal months, no equal numeric division); end lands exactly on a unit step -> regular item, endIncluded false (numeric-time convention)" } },

    { "id": "cal_month_clamp_jan31", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-31", "endDate": "2026-03-31", "calendarUnit": "months", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 3, "endIncluded": false,
        "itemAt": { "index": 1, "label": "Feb", "valueISO": "2026-02-28", "t": 0.4745762711864407, "ms": 1772236800000 },
        "last": { "index": 2, "label": "Mar", "valueISO": "2026-03-31", "t": 1 },
        "note": "day-of-month clamp policy: Jan 31 +1mo = Feb 28 (end-of-month clamp); step 2 re-derives from START so Jan 31 +2mo = Mar 31 (clamp does not compound)" } },

    { "id": "cal_ms_bounded_divisible_days", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2026-01-04", "calendarUnit": "days", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 4, "endIncluded": false,
        "first": { "ms": 1767225600000, "label": "2026-01-01", "valueISO": "2026-01-01" },
        "last": { "index": 3, "ms": 1767484800000, "t": 1, "label": "2026-01-04" },
        "tAscending": true,
        "note": "days = absolute 86400e3 ms stepping; exact boundary -> regular end item" } },

    { "id": "cal_ms_bounded_nondivisible_hours", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2026-01-01T05:30", "calendarUnit": "hours", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 7, "endIncluded": true,
        "first": { "valueISO": "2026-01-01T00:00", "label": "00:00" },
        "itemAt": { "index": 5, "label": "05:00", "t": 0.9090909090909091 },
        "last": { "index": 6, "t": 1, "label": "05:30", "valueISO": "2026-01-01T05:30" },
        "tAscending": true,
        "note": "5 full hour steps (00:00..05:00, t value-based) + appended endDate item t=1 endIncluded=true" } },

    { "id": "cal_seconds_unit", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01T00:00:00", "endDate": "2026-01-01T00:00:10", "calendarUnit": "seconds", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 11, "endIncluded": false,
        "first": { "label": "00:00:00", "valueISO": "2026-01-01T00:00:00" },
        "last": { "index": 10, "label": "00:00:10", "t": 1, "valueISO": "2026-01-01T00:00:10" },
        "tAscending": true,
        "note": "seconds = absolute 1e3 ms stepping; input carries seconds -> valueISO keeps :SS" } },

    { "id": "cal_days_feb2026_to_mar1", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-02-01", "endDate": "2026-03-01", "calendarUnit": "days", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 29, "endIncluded": false,
        "first": { "label": "2026-02-01" },
        "last": { "index": 28, "label": "2026-03-01", "t": 1, "valueISO": "2026-03-01" },
        "tAscending": true,
        "note": "28-day month: Feb 1 .. Mar 1" } },

    { "id": "cal_days_mar2026_to_apr1", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-03-01", "endDate": "2026-04-01", "calendarUnit": "days", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 32, "endIncluded": false,
        "last": { "index": 31, "label": "2026-04-01", "t": 1 },
        "tAscending": true,
        "note": "31-day month enumeration (spec 12.2: 30 vs 31 day months)" } },

    { "id": "cal_days_rollover_2025_2026", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2025-12-31", "endDate": "2026-01-01", "calendarUnit": "days", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 2, "endIncluded": false,
        "first": { "label": "2025-12-31", "valueISO": "2025-12-31" },
        "last": { "index": 1, "label": "2026-01-01", "valueISO": "2026-01-01", "t": 1 },
        "note": "year rollover (spec 12.2)" } },

    { "id": "cal_utc_hours_0_to_12", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2026-01-01T12:00", "calendarUnit": "hours", "includeEndPoint": true, "timeZone": "UTC" } },
      "expect": { "count": 13, "endIncluded": false,
        "first": { "ms": 1767225600000, "label": "00:00", "valueISO": "2026-01-01T00:00" },
        "itemAt": { "index": 5, "ms": 1767243600000, "label": "05:00", "valueISO": "2026-01-01T05:00", "t": 0.4166666666666667 },
        "last": { "index": 12, "label": "12:00", "t": 1 },
        "tAscending": true,
        "note": "UTC path is deterministic (Node + AE agree): abs positions and UTC wall clock" } },

    { "id": "cal_local_hours_day_runs", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-03-01", "endDate": "2026-03-02", "calendarUnit": "hours", "includeEndPoint": true, "timeZone": "LOCAL" } },
      "expect": { "count": 25, "tAscending": true,
        "note": "LOCAL zone: count is deterministic (24h real span -> 25 items; a DST shift inside the window would keep 25 but flip endIncluded, so it is NOT asserted); wall-clock labels are machine-dependent and NOT asserted here" } },

    { "id": "cal_dim_leap_feb2024", "kind": "daysInMonth", "input": { "y": 2024, "m": 2 }, "expect": { "equals": 29 } },
    { "id": "cal_dim_nonleap_feb2023", "kind": "daysInMonth", "input": { "y": 2023, "m": 2 }, "expect": { "equals": 28 } },
    { "id": "cal_dim_jan2026_31", "kind": "daysInMonth", "input": { "y": 2026, "m": 1 }, "expect": { "equals": 31 } },
    { "id": "cal_dim_apr2026_30", "kind": "daysInMonth", "input": { "y": 2026, "m": 4 }, "expect": { "equals": 30 } },
    { "id": "cal_dim_feb2000_leap400", "kind": "daysInMonth", "input": { "y": 2000, "m": 2 }, "expect": { "equals": 29 } },
    { "id": "cal_dim_feb1900_century", "kind": "daysInMonth", "input": { "y": 1900, "m": 2 }, "expect": { "equals": 28, "note": "proleptic Gregorian: 1900 not a leap year (divisible by 100, not by 400)" } },

    { "id": "cal_utc_ms_leap_anchor", "kind": "utcMs", "input": { "y": 2024, "m": 2, "d": 29 }, "expect": { "equals": 1709164800000, "note": "Date.UTC anchor for the leap day used by parseISO checks" } },

    { "id": "cal_parse_valid_full", "kind": "parseISO", "input": { "s": "2024-02-29T10:30:45" },
      "expect": { "fields": { "y": 2024, "m": 2, "d": 29, "h": 10, "mi": 30, "s": 45 } } },
    { "id": "cal_parse_valid_minute", "kind": "parseISO", "input": { "s": "2026-01-01T06:30" },
      "expect": { "fields": { "y": 2026, "m": 1, "d": 1, "h": 6, "mi": 30, "s": 0 } } },
    { "id": "cal_parse_feb30_invalid", "kind": "parseISO", "input": { "s": "2026-02-30" }, "expect": { "throws": "CALENDAR_DATE_INVALID" } },
    { "id": "cal_parse_hour24_invalid", "kind": "parseISO", "input": { "s": "2026-01-01T24:00" }, "expect": { "throws": "CALENDAR_DATE_INVALID" } },
    { "id": "cal_parse_minute60_invalid", "kind": "parseISO", "input": { "s": "2026-01-01T10:60" }, "expect": { "throws": "CALENDAR_DATE_INVALID" } },
    { "id": "cal_parse_format_nopad", "kind": "parseISO", "input": { "s": "2026-1-1" }, "expect": { "throws": "CALENDAR_DATE_FORMAT" } },
    { "id": "cal_parse_format_offset_rejected", "kind": "parseISO", "input": { "s": "2026-01-01T00:00:00Z" }, "expect": { "throws": "CALENDAR_DATE_FORMAT", "note": "v1: no timezone offsets / fractional seconds in the grammar" } },

    { "id": "cal_range_end_before_start", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-07-01", "endDate": "2026-01-01", "calendarUnit": "months" } },
      "expect": { "throws": "CALENDAR_RANGE" } },
    { "id": "cal_range_equal_dates", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2026-01-01", "calendarUnit": "months" } },
      "expect": { "throws": "CALENDAR_RANGE" } },

    { "id": "cal_cyclic_not_multiple_months", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-31", "endDate": "2026-03-01", "calendarUnit": "months", "distributionMode": "cyclic", "timeZone": "UTC" } },
      "expect": { "throws": "CALENDAR_CYCLIC_INVALID", "note": "Jan 31 +1mo = Feb 28 (clamped), +2mo = Mar 31: never lands on Mar 01" } },
    { "id": "cal_cyclic_not_multiple_days", "kind": "calendar",
      "input": { "timeCfg": { "mode": "calendar", "startDate": "2026-01-01", "endDate": "2026-01-01T12:00", "calendarUnit": "days", "distributionMode": "cyclic", "timeZone": "UTC" } },
      "expect": { "throws": "CALENDAR_CYCLIC_INVALID" } },

    { "id": "cal_label_mmm_yyyy", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 0, "mi": 0, "s": 0 }, "timeCfg": { "calendarUnit": "months", "dateFormat": "MMM YYYY" } },
      "expect": { "equals": "Jan 2026" } },
    { "id": "cal_label_yyyy_mm_dd", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 0, "mi": 0, "s": 0 }, "timeCfg": { "calendarUnit": "days", "dateFormat": "YYYY-MM-DD" } },
      "expect": { "equals": "2026-01-15" } },
    { "id": "cal_label_mmmm", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15 }, "timeCfg": { "calendarUnit": "months", "dateFormat": "MMMM" } },
      "expect": { "equals": "January" } },
    { "id": "cal_label_yyyy_mm", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15 }, "timeCfg": { "calendarUnit": "days", "dateFormat": "YYYY-MM" } },
      "expect": { "equals": "2026-01" } },
    { "id": "cal_label_ddmm", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15 }, "timeCfg": { "calendarUnit": "days", "dateFormat": "DDMM" } },
      "expect": { "equals": "1501", "note": "digit-pair concatenation, no separator (same convention as HHmm)" } },
    { "id": "cal_label_hhmmss", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30, "s": 15 }, "timeCfg": { "calendarUnit": "seconds", "dateFormat": "HHmmss" } },
      "expect": { "equals": "063015" } },
    { "id": "cal_label_hhmm", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30 }, "timeCfg": { "calendarUnit": "minutes", "dateFormat": "HHmm" } },
      "expect": { "equals": "0630" } },
    { "id": "cal_label_hh", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30 }, "timeCfg": { "calendarUnit": "hours", "dateFormat": "HH" } },
      "expect": { "equals": "06" } },
    { "id": "cal_label_mm", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30 }, "timeCfg": { "calendarUnit": "minutes", "dateFormat": "mm" } },
      "expect": { "equals": "30" } },
    { "id": "cal_label_ss", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30, "s": 15 }, "timeCfg": { "calendarUnit": "seconds", "dateFormat": "ss" } },
      "expect": { "equals": "15" } },

    { "id": "cal_label_default_years", "kind": "calendarLabel",
      "input": { "value": { "y": 2020, "m": 3, "d": 9 }, "timeCfg": { "calendarUnit": "years" } },
      "expect": { "equals": "2020" } },
    { "id": "cal_label_default_months", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 1 }, "timeCfg": { "calendarUnit": "months" } },
      "expect": { "equals": "Jan", "note": "3-letter English month default" } },
    { "id": "cal_label_default_days", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15 }, "timeCfg": { "calendarUnit": "days" } },
      "expect": { "equals": "2026-01-15" } },
    { "id": "cal_label_default_hours", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 0 }, "timeCfg": { "calendarUnit": "hours" } },
      "expect": { "equals": "06:00" } },
    { "id": "cal_label_default_minutes", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30 }, "timeCfg": { "calendarUnit": "minutes" } },
      "expect": { "equals": "06:30" } },
    { "id": "cal_label_default_seconds", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15, "h": 6, "mi": 30, "s": 15 }, "timeCfg": { "calendarUnit": "seconds" } },
      "expect": { "equals": "06:30:15" } },
    { "id": "cal_label_empty_fmt", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15 }, "timeCfg": { "calendarUnit": "days", "dateFormat": "" } },
      "expect": { "equals": "2026-01-15", "note": "empty format -> unit default" } },
    { "id": "cal_label_unknown_fmt", "kind": "calendarLabel",
      "input": { "value": { "y": 2026, "m": 1, "d": 15 }, "timeCfg": { "calendarUnit": "months", "dateFormat": "Zz" } },
      "expect": { "equals": "Jan", "note": "format with no recognized token -> unit default" } }
  ]
}
